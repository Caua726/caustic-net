// =======================================================
// tests/test_ent.cst — core/entropy.cst
//
// Randomness is awkward to test: every output is legal. So the checks here are
// about the things that are NOT random — the contract, the boundaries, and the
// failure modes that would otherwise be invisible:
//
//   * the count comes back, in full, for sizes on both sides of getrandom's
//     256-byte short-read boundary;
//   * nothing is written past the requested length;
//   * the buffer is actually touched (a source that fails silently and leaves
//     stack bytes in place is the exact bug this module exists to prevent);
//   * the output is not a constant — a stuck source passes "it changed" if the
//     constant differs from the poison, so bit balance is checked too.
//
// Exit 0 = all pass. Non-zero = the numbered check that failed.
// =======================================================

use "../core/entropy.cst" as ent;
use "../core/errno.cst" as errno;

let is u8 as POISON with imut = 0xA5;

fn poison(p as *u8, n as i64) as void {
    let is i64 as i with mut = 0;
    while (i < n) { p[i] = POISON; i = i + 1; }
}

// How many of the first n bytes are still the poison value.
fn untouched(p as *u8, n as i64) as i64 {
    let is i64 as k with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) {
        if (p[i] == POISON) { k = k + 1; }
        i = i + 1;
    }
    return k;
}

fn popcount8(b as u8) as i64 {
    let is i64 as v with mut = cast(i64, b);
    let is i64 as n with mut = 0;
    while (v != 0) {
        n = n + (v & 1);
        v = v >> 1;
    }
    return n;
}

fn main() as i32 {
    // --- Contract on the arguments ---------------------------------------
    let is [64]u8 as small;
    if (ent.entropy_fill(cast(*u8, &small), 0) != 0) { return 1; }
    if (ent.entropy_fill(cast(*u8, &small), 0 - 1) != 0 - errno.EINVAL) { return 2; }
    if (ent.entropy_fill(cast(*u8, 0), 8) != 0 - errno.EFAULT) { return 3; }
    // A zero-length fill on a null pointer is still a no-op, not a fault:
    // the pointer is never dereferenced.
    if (ent.entropy_fill(cast(*u8, 0), 0) != 0) { return 4; }

    // --- It writes, and it writes exactly as much as it was asked to -------
    // 8 KiB with a guard: the fill is 4096, and the 4096 bytes after it must
    // still be poison. Writing past the length is the bug that turns a nonce
    // into a corrupted neighbouring struct.
    let is [8192]u8 as big;
    poison(cast(*u8, &big), 8192);
    if (ent.entropy_fill(cast(*u8, &big), 4096) != 4096) { return 5; }
    if (untouched(cast(*u8, cast(i64, &big) + 4096), 4096) != 4096) { return 6; }

    // Of 4096 random bytes, the expected count still equal to 0xA5 is 16. A
    // source that returned without writing leaves 4096. Anything above 80 is
    // not chance — it is a source that half-failed.
    if (untouched(cast(*u8, &big), 4096) > 80) { return 7; }

    // --- Not a constant ---------------------------------------------------
    // "It changed from the poison" is satisfied by a source stuck at 0x00.
    // Over 4096 bytes the set-bit count should sit near 16384; a constant byte
    // pins it to a multiple of 4096 and lands far outside this window.
    let is i64 as bits with mut = 0;
    let is i64 as i with mut = 0;
    while (i < 4096) {
        bits = bits + popcount8(big[i]);
        i = i + 1;
    }
    if (bits < 15000) { return 8; }
    if (bits > 17800) { return 9; }

    // --- Sizes across getrandom's 256-byte guarantee ----------------------
    // At or below 256 the kernel promises a full write; above it the loop in
    // entropy_fill is what makes the result whole.
    let is [1024]u8 as mid;
    if (ent.entropy_fill(cast(*u8, &mid), 1) != 1) { return 10; }
    if (ent.entropy_fill(cast(*u8, &mid), 255) != 255) { return 11; }
    if (ent.entropy_fill(cast(*u8, &mid), 256) != 256) { return 12; }
    if (ent.entropy_fill(cast(*u8, &mid), 257) != 257) { return 13; }
    if (ent.entropy_fill(cast(*u8, &mid), 1024) != 1024) { return 14; }

    // --- Two calls differ -------------------------------------------------
    // 32 bytes colliding is 2^-256. If this fires, the source is not random.
    let is [32]u8 as a;
    let is [32]u8 as b;
    if (ent.entropy_fill(cast(*u8, &a), 32) != 32) { return 15; }
    if (ent.entropy_fill(cast(*u8, &b), 32) != 32) { return 16; }
    let is i64 as same with mut = 0;
    i = 0;
    while (i < 32) {
        if (a[i] == b[i]) { same = same + 1; }
        i = i + 1;
    }
    if (same == 32) { return 17; }

    // --- entropy_u16: a DNS query ID --------------------------------------
    let is i64 as id with mut = 0 - 1;
    let is i64 as seen with mut = 0;
    let is i64 as first with mut = 0 - 1;
    let is i64 as varied with mut = 0;
    i = 0;
    while (i < 64) {
        if (ent.entropy_u16(&id) != 0) { return 18; }
        if (id < 0) { return 19; }
        if (id > 65535) { return 20; }
        if (first < 0) { first = id; }
        if (id != first) { varied = 1; }
        seen = seen + 1;
        i = i + 1;
    }
    if (seen != 64) { return 21; }
    // 64 draws all landing on the same 16-bit value is 2^-1008.
    if (varied == 0) { return 22; }

    // --- entropy_u56: never negative --------------------------------------
    // The sign bit is where this would go wrong, and it would go wrong half
    // the time, silently, as a value that every other function here reads as
    // an error code.
    let is i64 as v with mut = 0;
    i = 0;
    while (i < 256) {
        if (ent.entropy_u56(&v) != 0) { return 23; }
        if (v < 0) { return 24; }
        i = i + 1;
    }

    return 0;
}
