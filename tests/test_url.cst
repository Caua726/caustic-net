// =======================================================
// caustic-net/tests/test_url.cst
// Covers proto/url.cst.
//
// The interesting cases are the ones that make naive splitters
// produce a wrong HOST, because a wrong host is a request sent to
// the wrong machine: userinfo containing '@', an IPv6 literal full
// of colons that are not a port separator, and a port that
// overflows u16.
//
// Exit 0 = all pass. Non-zero = the numbered check that failed.
// =======================================================

use "../proto/url.cst" as url;

fn eq(a as *u8, b as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    if (a[i] != b[i]) { return 0; }
    return 1;
}

// Resolve `ref` against `base` and compare the result with `want`.
fn chk_res(base as *url.Url, buf as *u8, ref as *u8, want as *u8) as i64 {
    let is url.Url as r = url.url_resolve(base, ref, buf, 256);
    if (r.ok != 0) { return 0; }
    return eq(buf, want);
}

fn main() as i32 {
    let is [256]u8 as b;

    // ---- 1: the ordinary case, every part present
    let is url.Url as u with mut =
        url.url_parse("https://user:pw@example.com:8443/a/b?x=1&y=2#frag");
    if (u.ok != 0) { return 1; }
    if (url.url_scheme(&u, cast(*u8, &b), 256) < 0) { return 2; }
    if (eq(cast(*u8, &b), "https") == 0) { return 3; }
    url.url_host(&u, cast(*u8, &b), 256);
    if (eq(cast(*u8, &b), "example.com") == 0) { return 4; }
    if (u.port != 8443) { return 5; }
    if (u.tls != 1) { return 6; }
    url.url_user(&u, cast(*u8, &b), 256);
    if (eq(cast(*u8, &b), "user:pw") == 0) { return 7; }
    url.url_path(&u, cast(*u8, &b), 256);
    if (eq(cast(*u8, &b), "/a/b") == 0) { return 8; }
    url.url_query(&u, cast(*u8, &b), 256);
    if (eq(cast(*u8, &b), "x=1&y=2") == 0) { return 9; }
    url.url_fragment(&u, cast(*u8, &b), 256);
    if (eq(cast(*u8, &b), "frag") == 0) { return 10; }

    // The request line carries path+query and NEVER the fragment.
    url.url_request_target(&u, cast(*u8, &b), 256);
    if (eq(cast(*u8, &b), "/a/b?x=1&y=2") == 0) { return 11; }

    // ---- 12: no path at all defaults to "/" — a bare origin is still a GET /
    u = url.url_parse("http://example.com");
    if (u.ok != 0) { return 12; }
    if (u.port != 80) { return 13; }
    if (u.tls != 0) { return 14; }
    url.url_path(&u, cast(*u8, &b), 256);
    if (eq(cast(*u8, &b), "/") == 0) { return 15; }
    url.url_request_target(&u, cast(*u8, &b), 256);
    if (eq(cast(*u8, &b), "/") == 0) { return 16; }
    // Default port must be OMITTED from the Host header.
    url.url_host_header(&u, cast(*u8, &b), 256);
    if (eq(cast(*u8, &b), "example.com") == 0) { return 17; }

    // ---- 18: a NON-default port must be present in the Host header
    u = url.url_parse("http://example.com:8080/");
    if (u.ok != 0) { return 18; }
    url.url_host_header(&u, cast(*u8, &b), 256);
    if (eq(cast(*u8, &b), "example.com:8080") == 0) { return 19; }
    // 443 is default for https but NOT for http, so it must show.
    u = url.url_parse("http://example.com:443/");
    url.url_host_header(&u, cast(*u8, &b), 256);
    if (eq(cast(*u8, &b), "example.com:443") == 0) { return 20; }
    // ...and the same number IS the default under https, so it must not.
    u = url.url_parse("https://example.com:443/");
    url.url_host_header(&u, cast(*u8, &b), 256);
    if (eq(cast(*u8, &b), "example.com") == 0) { return 21; }

    // ---- 22: userinfo containing '@'. The LAST '@' delimits, so the host is
    // ---- "real.host" — splitting on the first '@' would send this to "b".
    u = url.url_parse("http://a@b:c@real.host/p");
    if (u.ok != 0) { return 22; }
    url.url_host(&u, cast(*u8, &b), 256);
    if (eq(cast(*u8, &b), "real.host") == 0) { return 23; }
    url.url_user(&u, cast(*u8, &b), 256);
    if (eq(cast(*u8, &b), "a@b:c") == 0) { return 24; }

    // ---- 25: IPv6 literal. Colons inside the brackets are NOT a port.
    u = url.url_parse("http://[2001:db8::1]/x");
    if (u.ok != 0) { return 25; }
    if (u.ip6 != 1) { return 26; }
    url.url_host(&u, cast(*u8, &b), 256);            // host has NO brackets...
    if (eq(cast(*u8, &b), "2001:db8::1") == 0) { return 27; }
    if (u.port != 80) { return 28; }
    url.url_host_header(&u, cast(*u8, &b), 256);     // ...but the header does
    if (eq(cast(*u8, &b), "[2001:db8::1]") == 0) { return 29; }

    // IPv6 WITH an explicit port: only the colon after ']' counts.
    u = url.url_parse("https://[::1]:8443/");
    if (u.ok != 0) { return 30; }
    url.url_host(&u, cast(*u8, &b), 256);
    if (eq(cast(*u8, &b), "::1") == 0) { return 31; }
    if (u.port != 8443) { return 32; }
    url.url_host_header(&u, cast(*u8, &b), 256);
    if (eq(cast(*u8, &b), "[::1]:8443") == 0) { return 33; }

    // ---- 34: scheme case-insensitivity — HTTPS:// is still TLS on 443
    u = url.url_parse("HTTPS://Example.COM/");
    if (u.ok != 0) { return 34; }
    if (u.tls != 1 || u.port != 443) { return 35; }
    if (url.url_scheme_is(&u, "https") != 1) { return 36; }
    if (url.url_host_is(&u, "example.com") != 1) { return 37; }

    // ---- 38: query present but empty, and a fragment with no query
    u = url.url_parse("http://h/p?");
    if (u.ok != 0 || u.query_len != 0) { return 38; }
    url.url_request_target(&u, cast(*u8, &b), 256);
    if (eq(cast(*u8, &b), "/p") == 0) { return 39; }
    u = url.url_parse("http://h/p#only-frag");
    if (u.ok != 0) { return 40; }
    url.url_request_target(&u, cast(*u8, &b), 256);
    if (eq(cast(*u8, &b), "/p") == 0) { return 41; }

    // ---- 42: malformed inputs must be REFUSED, not silently half-parsed
    if (url.url_parse("").ok            != url.URL_ERR_EMPTY)  { return 42; }
    if (url.url_parse("example.com").ok != url.URL_ERR_SCHEME) { return 43; }
    if (url.url_parse("http:/x").ok     != url.URL_ERR_SCHEME) { return 44; }
    if (url.url_parse("1http://x").ok   != url.URL_ERR_SCHEME) { return 45; }
    if (url.url_parse("http:///p").ok   != url.URL_ERR_HOST)   { return 46; }
    if (url.url_parse("http://[::1/p").ok != url.URL_ERR_HOST) { return 47; }
    // A port that overflows u16 is a hard error, not a truncation.
    if (url.url_parse("http://h:99999/").ok != url.URL_ERR_PORT) { return 48; }
    if (url.url_parse("http://h:80x/").ok   != url.URL_ERR_PORT) { return 49; }
    if (url.url_parse("http://h:/").ok      != url.URL_ERR_PORT) { return 50; }
    // 65535 is the largest legal port and must still pass.
    u = url.url_parse("http://h:65535/");
    if (u.ok != 0 || u.port != 65535) { return 51; }

    // ---- 52: a buffer too small reports it instead of overflowing
    let is [4]u8 as tiny;
    u = url.url_parse("http://averylonghostname.example/");
    if (u.ok != 0) { return 52; }
    if (url.url_host(&u, cast(*u8, &tiny), 4) != url.URL_ERR_SPACE) { return 53; }
    // A host that exactly fills the buffer (3 chars + NUL) still fits.
    u = url.url_parse("http://abc/");
    if (url.url_host(&u, cast(*u8, &tiny), 4) != 3) { return 54; }

    // ---- 55: percent-decoding
    let is [64]u8 as dec;
    let is i64 as dn with mut = url.pct_decode("a%20b%2Fc", 9, cast(*u8, &dec), 64);
    if (dn != 5) { return 55; }
    if (eq(cast(*u8, &dec), "a b/c") == 0) { return 56; }
    // %ZZ is not hex, so it stays literal rather than killing the parse.
    dn = url.pct_decode("100%ZZ", 6, cast(*u8, &dec), 64);
    if (dn != 6) { return 57; }
    if (eq(cast(*u8, &dec), "100%ZZ") == 0) { return 58; }
    // A '%' at the very end has no room for two digits — also literal.
    dn = url.pct_decode("ab%", 3, cast(*u8, &dec), 64);
    if (dn != 3) { return 59; }
    if (eq(cast(*u8, &dec), "ab%") == 0) { return 60; }
    // Lowercase hex decodes the same as uppercase.
    dn = url.pct_decode("%2f%2F", 6, cast(*u8, &dec), 64);
    if (dn != 2) { return 61; }
    if (eq(cast(*u8, &dec), "//") == 0) { return 62; }

    // ---- 63: percent-encoding a query component. '&' and '=' are separators
    // ---- and MUST be escaped, or one value smuggles in extra parameters.
    let is [64]u8 as enc;
    let is i64 as en with mut = url.pct_encode("a b&c=d", 7, cast(*u8, &enc), 64);
    if (eq(cast(*u8, &enc), "a%20b%26c%3Dd") == 0) { return 63; }
    if (en != 13) { return 64; }
    // Unreserved characters pass through untouched.
    en = url.pct_encode("Az0-._~", 7, cast(*u8, &enc), 64);
    if (eq(cast(*u8, &enc), "Az0-._~") == 0) { return 65; }
    // Round trip.
    let is [64]u8 as back;
    url.pct_decode(cast(*u8, &enc), en, cast(*u8, &back), 64);
    if (eq(cast(*u8, &back), "Az0-._~") == 0) { return 66; }

    // A too-small output buffer is reported, not overrun.
    let is [4]u8 as small;
    if (url.pct_encode("a b&c", 5, cast(*u8, &small), 4) != url.URL_ERR_SPACE) { return 67; }

    // ---- 68: relative reference resolution, RFC 3986 §5.2.
    // The cases below are the normative examples of §5.4, which exist because
    // every one of them has a plausible wrong answer. A Location header is
    // allowed to be relative and usually is, so getting these wrong means
    // following a redirect to the wrong place.
    let is url.Url as rbase with mut = url.url_parse("http://a/b/c/d;p?q");
    if (rbase.ok != 0) { return 68; }
    let is [256]u8 as rb;

    // §5.4.1 normal examples
    if (chk_res(&rbase, cast(*u8, &rb), "g",     "http://a/b/c/g")      == 0) { return 69; }
    if (chk_res(&rbase, cast(*u8, &rb), "./g",   "http://a/b/c/g")      == 0) { return 70; }
    if (chk_res(&rbase, cast(*u8, &rb), "g/",    "http://a/b/c/g/")     == 0) { return 71; }
    if (chk_res(&rbase, cast(*u8, &rb), "/g",    "http://a/g")          == 0) { return 72; }
    // The §5.4.1 table gives "http://g" here, with no path at all. This asserts
    // "http://g/" deliberately: §6.2.3 normalises an empty path under an
    // authority to "/", so the two are equivalent, and HTTP wants the slash —
    // a request line needs a target. Reading §5.4 alone this looks like a
    // mismatch, which is why it is called out; url_resolve says the same where
    // it writes the slash. Do not "correct" it to match the table.
    if (chk_res(&rbase, cast(*u8, &rb), "//g",   "http://g/")           == 0) { return 73; }
    if (chk_res(&rbase, cast(*u8, &rb), "?y",    "http://a/b/c/d;p?y")  == 0) { return 74; }
    if (chk_res(&rbase, cast(*u8, &rb), "g?y",   "http://a/b/c/g?y")    == 0) { return 75; }
    if (chk_res(&rbase, cast(*u8, &rb), "#s",    "http://a/b/c/d;p?q#s")== 0) { return 76; }
    if (chk_res(&rbase, cast(*u8, &rb), "g#s",   "http://a/b/c/g#s")    == 0) { return 77; }
    if (chk_res(&rbase, cast(*u8, &rb), "g?y#s", "http://a/b/c/g?y#s")  == 0) { return 78; }
    if (chk_res(&rbase, cast(*u8, &rb), ";x",    "http://a/b/c/;x")     == 0) { return 79; }
    if (chk_res(&rbase, cast(*u8, &rb), "g;x",   "http://a/b/c/g;x")    == 0) { return 80; }
    if (chk_res(&rbase, cast(*u8, &rb), "",      "http://a/b/c/d;p?q")  == 0) { return 81; }
    if (chk_res(&rbase, cast(*u8, &rb), ".",     "http://a/b/c/")       == 0) { return 82; }
    if (chk_res(&rbase, cast(*u8, &rb), "./",    "http://a/b/c/")       == 0) { return 83; }
    if (chk_res(&rbase, cast(*u8, &rb), "..",    "http://a/b/")         == 0) { return 84; }
    if (chk_res(&rbase, cast(*u8, &rb), "../",   "http://a/b/")         == 0) { return 85; }
    if (chk_res(&rbase, cast(*u8, &rb), "../g",  "http://a/b/g")        == 0) { return 86; }
    if (chk_res(&rbase, cast(*u8, &rb), "../..", "http://a/")           == 0) { return 87; }
    if (chk_res(&rbase, cast(*u8, &rb), "../../g", "http://a/g")        == 0) { return 88; }
    // An absolute reference ignores the base entirely.
    if (chk_res(&rbase, cast(*u8, &rb), "https://x/y", "https://x/y")   == 0) { return 89; }

    // §5.4.2 abnormal: ".." may not climb above the root, and the extra ones
    // are absorbed rather than producing a path that escapes the authority.
    if (chk_res(&rbase, cast(*u8, &rb), "../../../g",    "http://a/g")  == 0) { return 90; }
    if (chk_res(&rbase, cast(*u8, &rb), "../../../../g", "http://a/g")  == 0) { return 91; }
    if (chk_res(&rbase, cast(*u8, &rb), "/./g",          "http://a/g")  == 0) { return 92; }
    if (chk_res(&rbase, cast(*u8, &rb), "/../g",         "http://a/g")  == 0) { return 93; }
    // A dot inside a name is not a dot SEGMENT.
    if (chk_res(&rbase, cast(*u8, &rb), "g.",  "http://a/b/c/g.")       == 0) { return 94; }
    if (chk_res(&rbase, cast(*u8, &rb), ".g",  "http://a/b/c/.g")       == 0) { return 95; }
    if (chk_res(&rbase, cast(*u8, &rb), "g..", "http://a/b/c/g..")      == 0) { return 96; }
    if (chk_res(&rbase, cast(*u8, &rb), "..g", "http://a/b/c/..g")      == 0) { return 97; }

    // ---- 98: the port and an IPv6 host survive resolution, which is what
    // ---- makes a redirect on a non-default port still reach the same server.
    let is url.Url as rb6 with mut = url.url_parse("https://[2001:db8::1]:8443/api/v1/x");
    if (rb6.ok != 0) { return 98; }
    if (chk_res(&rb6, cast(*u8, &rb), "../v2/y", "https://[2001:db8::1]:8443/api/v2/y") == 0) { return 99; }
    // The resolved Url is usable, not just a string.
    let is url.Url as rr6 with mut = url.url_resolve(&rb6, "/z", cast(*u8, &rb), 256);
    if (rr6.ok != 0) { return 100; }
    if (rr6.port != 8443) { return 101; }
    if (rr6.ip6 != 1) { return 102; }
    if (rr6.tls != 1) { return 103; }
    url.url_host(&rr6, cast(*u8, &b), 256);
    if (eq(cast(*u8, &b), "2001:db8::1") == 0) { return 104; }

    // An absolute reference carries its authority through verbatim, default
    // port included — §5.2.2 assigns R.authority, and dropping the port is
    // normalisation (§6.2.3), a separate step this does not perform on input
    // the caller wrote out in full.
    if (chk_res(&rbase, cast(*u8, &rb), "http://h:80/p", "http://h:80/p") == 0) { return 105; }
    // A base's authority is rebuilt from parts rather than copied, because that
    // is all a parsed Url keeps — and its port field is already the scheme
    // default when the URL omitted one, so emitting it would turn every
    // resolution against "http://a/b" into "http://a:80/...".
    if (chk_res(&rbase, cast(*u8, &rb), "g", "http://a/b/c/g") == 0) { return 108; }
    let is url.Url as rp = url.url_parse("http://a:8080/b/c");
    if (chk_res(&rp, cast(*u8, &rb), "g", "http://a:8080/b/g") == 0) { return 109; }

    // A buffer too small is reported, not overrun.
    let is [8]u8 as tiny;
    let is url.Url as rsm with mut = url.url_resolve(&rb6, "/verylongpath", cast(*u8, &tiny), 8);
    if (rsm.ok != url.URL_ERR_SPACE) { return 106; }

    // Resolving against a base that never parsed cannot invent an answer.
    let is url.Url as rbad with mut = url.url_parse("nonsense");
    let is url.Url as rres with mut = url.url_resolve(&rbad, "/x", cast(*u8, &rb), 256);
    if (rres.ok == 0) { return 107; }

    return 0;
}
