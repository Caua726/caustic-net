// =======================================================
// caustic-net/tests/test_par_pool.cst
// Many threads, one pool, one socket each — reused.
//
// This closes gap 21. `client/parallel` and `client/connpool` were each tested
// on their own and never together, and the README said so in the shape of an
// admission: "the pool's mutex is the argument that it is safe to share; it is
// not a test."
//
// The reason it stayed open was not the library. Combining them needs a
// CONCURRENT server, and a concurrent server needs threads, and threads
// segfaulted under the optimizing backend — Caustic's inliner was duplicating
// std/thread's `naked` clone trampoline, so the `ret` inside it returned from
// `spawn`. Fixed in Caustic v0.1.7. tests/test_parallel's server is a single
// thread that answers one request per connection and closes, which is exactly
// the server that CANNOT show reuse.
//
// So the server here is different in two ways that both matter:
//
//   * THREAD PER CONNECTION. A worker holding an idle keep-alive socket must
//     not block the others. With a single-threaded server the result depends on
//     which of two blocking things blocked first, which measures nothing.
//   * KEEP-ALIVE. Each connection serves requests until the client stops
//     asking or five seconds pass. A server that closes after one response
//     leaves nothing to reuse, and the test would pass while proving nothing.
//
// Twelve jobs through four workers is three waves. Wave 1 opens four sockets
// and returns them to the pool; waves 2 and 3 should find them there. That is
// the claim: POOL_MIN_HITS below is one full wave, and the exact number is
// printed on every run.
//
// The server runs as a second PROCESS, like tests/test_fetch and
// tests/test_pool. That was adopted to dodge the miscompile and kept because it
// is closer to what a client actually faces.
//
// Exit 0 = all pass. Non-zero = the numbered check that failed.
// =======================================================

use "std/io.cst" as io;
use "std/process.cst" as proc;
use "std/env.cst" as env;
use "std/time.cst" as time;
use "std/thread.cst" as thread;
use "../core/conn.cst" as conn;
use "../core/bufread.cst" as bufread;
use "../transport/transport.cst" as tp;
use "../tls/trust.cst" as trust;
use "../client/connpool.cst" as pool;
use "../client/parallel.cst" as par;

let is i64 as PORT     with imut = 18098;
let is i64 as NJOBS    with imut = 12;
let is i64 as WORKERS  with imut = 4;
// One full wave of reuse. Asserting all eight would make the test depend on the
// server never timing a socket out mid-run; asserting one would pass on an
// accident. A wave is the smallest number that can only come from the pool.
let is i64 as POOL_MIN_HITS with imut = 4;

// How long a server thread waits for the next request on a connection it is
// holding. Long enough that three waves of client work never trip it, short
// enough that the process exits on its own if the client dies.
let is i64 as IDLE_SECS with imut = 5;

let is i64 as MAX_CONNS with imut = 64;

let is tp.Listener as _l with mut;
let is [64]thread.Thread as _th with mut;
let is i64 as _nth with mut = 0;

fn streq(a as *u8, b as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    if (a[i] != b[i]) { return 0; }
    return 1;
}

fn target_of(line as *u8, out as *u8, max as i64) as i64 {
    let is i64 as i with mut = 0;
    while (line[i] != 0 && line[i] != 32) { i = i + 1; }
    if (line[i] == 0) { return 0 - 1; }
    i = i + 1;
    let is i64 as n with mut = 0;
    while (line[i] != 0 && line[i] != 32 && n < max - 1) {
        out[n] = line[i];
        n = n + 1;
        i = i + 1;
    }
    out[n] = cast(u8, 0);
    return n;
}

// One connection, for as long as the client keeps using it.
//
// `arg` is the *Conn, which is all std/thread's spawn can carry — the same
// no-closure shape as the Conn vtable and as client/parallel's Job.
fn serve_conn(arg as i64) as i64 {
    let is *conn.Conn as c = cast(*conn.Conn, arg);
    // Without this, a thread parked on a client that has moved on holds the
    // process open until someone kills it.
    tp.set_recv_timeout(c, IDLE_SECS);

    let is [4096]u8 as sbuf;
    let is bufread.BufReader as br;
    bufread.br_init(&br, c, cast(*u8, &sbuf), 4096);
    let is [1024]u8 as line;

    let is i64 as served with mut = 0;
    while (served < 64) {
        let is i64 as n = bufread.br_read_line(&br, cast(*u8, &line), 1024);
        if (n <= 0) { break; }              // EOF, or the idle timeout fired
        let is [256]u8 as path;
        if (target_of(cast(*u8, &line), cast(*u8, &path), 256) < 0) { break; }
        // Headers, up to and including the blank line.
        while (1 == 1) {
            let is i64 as k = bufread.br_read_line(&br, cast(*u8, &line), 1024);
            if (k <= 0) { break; }
        }

        // "/j7" answers with eight bytes of '7', so a body landing in the wrong
        // Job is a failure rather than a coincidence.
        let is i64 as pn with mut = 0;
        while (path[pn] != 0) { pn = pn + 1; }
        let is u8 as tag = path[pn - 1];
        let is [64]u8 as body;
        let is i64 as i with mut = 0;
        while (i < 8) { body[i] = tag; i = i + 1; }

        // No Connection: close — HTTP/1.1 keeps it, which is the point.
        conn.conn_write_all(c, "HTTP/1.1 200 OK\r\nContent-Length: 8\r\n\r\n", 38);
        conn.conn_write_all(c, cast(*u8, &body), 8);
        served = served + 1;
    }
    conn.conn_close(c);
    conn.conn_free(c);
    return 0;
}

fn server_main() as i32 {
    // Before any thread exists: this warms the Conn and Bytes heaps and the
    // resolver while the process is still single-threaded. Every thread below
    // allocates through those.
    tp.init();
    let is tp.ListenResult as lr with mut = tp.listen_loopback(PORT);
    if (lr.ok < 0) { return 1; }
    _l = lr.l;

    // Accept until the client has been quiet for twelve seconds, or the thread
    // table is full. No backlog draining needed here, unlike test_parallel: a
    // connection is handed to a thread immediately, so the accept loop is never
    // the thing that blocks.
    let is i64 as idle with mut = 0;
    while (idle < 60 && _nth < MAX_CONNS) {
        if (tp.listener_wait(&_l, 200) <= 0) { idle = idle + 1; continue; }
        idle = 0;
        let is *conn.Conn as c = tp.accept_conn(&_l);
        if (cast(i64, c) == 0) { continue; }
        let is *thread.Thread as t =
            cast(*thread.Thread, cast(i64, &_th) + _nth * sizeof(thread.Thread));
        if (thread.spawn(t, fn_ptr(serve_conn), cast(i64, c)) != 0) {
            conn.conn_close(c);
            conn.conn_free(c);
            continue;
        }
        _nth = _nth + 1;
    }

    tp.listener_close(&_l);
    // Join before exiting, so the stacks are released and a leak here is a
    // leak rather than something the process teardown hides.
    let is i64 as j with mut = 0;
    while (j < _nth) {
        thread.join(cast(*thread.Thread, cast(i64, &_th) + j * sizeof(thread.Thread)));
        j = j + 1;
    }
    return 0;
}

// "http://127.0.0.1:18098/j<K>"
fn job_url(k as i64, out as *u8) as void {
    let is *u8 as base = "http://127.0.0.1:18098/j";
    let is i64 as n with mut = 0;
    while (base[n] != 0) { out[n] = base[n]; n = n + 1; }
    if (k >= 10) {
        out[n] = cast(u8, 48 + (k / 10));
        n = n + 1;
    }
    out[n] = cast(u8, 48 + (k % 10));
    n = n + 1;
    out[n] = cast(u8, 0);
}

fn run_checks(b as *par.Batch, p as *pool.Pool) as i64 {
    let is i64 as t0 = time.now_ms();
    let is i64 as ok = par.batch_run(b, conn.deadline_in(30000));
    let is i64 as ms = time.now_ms() - t0;

    if (ok != NJOBS) {
        io.printf("%ld of %ld succeeded in %ld ms\n", ok, NJOBS, ms);
        let is i64 as i with mut = 0;
        while (i < par.batch_count(b)) {
            if (par.job_rc(b, i) != 0) {
                io.printf("  %s -> %ld (status %ld)\n",
                          par.job_url(b, i), par.job_rc(b, i), par.job_status(b, i));
            }
            i = i + 1;
        }
        return 40;
    }

    // Every job got ITS OWN body. Twelve threads sharing one pool is exactly
    // where handing the wrong socket to the wrong worker would show up — and it
    // would show up as job 3 reading job 7's bytes off a connection that was
    // still mid-response.
    let is i64 as i with mut = 0;
    while (i < NJOBS) {
        if (par.job_status(b, i) != 200) { return 41; }
        if (par.job_body_len(b, i) != 8) {
            io.printf("job %ld body is %ld bytes\n", i, par.job_body_len(b, i));
            return 42;
        }
        let is *u8 as body = par.job_body(b, i);
        let is u8 as want = cast(u8, 48 + (i % 10));
        let is i64 as k with mut = 0;
        while (k < 8) {
            if (body[k] != want) {
                io.printf("job %ld got '%c' where '%c' was expected\n",
                          i, cast(i64, body[k]), cast(i64, want));
                return 43;
            }
            k = k + 1;
        }
        i = i + 1;
    }

    // The claim this file exists to make: the second and third waves came out
    // of the pool rather than opening new sockets.
    let is i64 as hits = pool.pool_hits(p);
    if (hits < POOL_MIN_HITS) {
        io.printf("only %ld reuse(s) across %ld jobs — the pool was not shared\n",
                  hits, NJOBS);
        return 44;
    }
    // ...and the sockets are still held afterwards rather than closed.
    if (pool.pool_idle(p) <= 0) { return 45; }

    io.printf("  %ld jobs in %ld ms, %ld reuse(s), %ld socket(s) still idle\n",
              NJOBS, ms, hits, pool.pool_idle(p));
    return 0;
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    if (argc > 1) {
        if (streq(env.argv(1), "--server") == 1) { return server_main(); }
    }
    tp.init();

    let is [1024]u8 as self;
    if (io.get_self_path(cast(*u8, &self), 1024) <= 0) { return 1; }
    let is [3]i64 as sav;
    sav[0] = cast(i64, cast(*u8, &self));
    sav[1] = cast(i64, "--server");
    sav[2] = 0;
    let is i64 as spid = proc.spawnp(cast(*u8, &self), cast(*u8, &sav));
    if (spid <= 0) { return 2; }

    let is i64 as tries with mut = 0;
    while (tries < 200) {
        let is *conn.Conn as probe = tp.dial("127.0.0.1", PORT);
        if (cast(i64, probe) != 0) { conn.conn_free(probe); break; }
        time.sleep_ms(10);
        tries = tries + 1;
    }
    if (tries >= 200) { return 3; }

    // ONE pool, shared by every job in the batch. client/connpool's mutex is
    // what makes that safe; this is the test of it.
    let is pool.Pool as p;
    if (pool.pool_init(&p, 32) != 0) { return 4; }

    let is par.Batch as b;
    if (par.batch_init(&b, 32, cast(*trust.TrustStore, 0), &p) != 0) { return 5; }
    b.workers = WORKERS;

    let is [64]u8 as u;
    let is i64 as i with mut = 0;
    while (i < NJOBS) {
        job_url(i, cast(*u8, &u));
        if (par.batch_add(&b, cast(*u8, &u)) != i) { return 6; }
        i = i + 1;
    }

    let is i64 as bad = run_checks(&b, &p);
    let is i64 as hits = pool.pool_hits(&p);

    par.batch_free(&b);
    pool.pool_free(&p);
    proc.wait_pid(spid);

    if (bad != 0) {
        io.printf("check %ld failed\n", bad);
        return cast(i32, bad);
    }
    io.printf("parallel+pool ok: %ld jobs, %ld at a time, %ld socket(s) reused\n",
              NJOBS, WORKERS, hits);
    return 0;
}
