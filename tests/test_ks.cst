// =======================================================
// tests/test_ks.cst — tls/transcript.cst and tls/keysched.cst
//
// Against RFC 8448 §3, "Simple 1-RTT Handshake", which publishes every
// intermediate value of a real TLS 1.3 exchange. That is what makes this
// module testable before a single byte of protocol exists, and it is why it is
// written first: the key schedule's failure mode is a Finished MAC that does
// not verify, thirty byte-exact details downstream of the mistake, with
// nothing in between to tell you which one.
//
// The vectors were extracted from the RFC text programmatically, not
// transcribed — a summary of the same document silently dropped a byte from
// the handshake secret and altered digits in another, and a "vector" that is
// wrong is worse than none.
//
// Two kinds of check. The SECRETS confirm the chain end to end. The INFO
// blocks confirm the HkdfLabel encoding directly, byte for byte, which is
// where the mistakes actually live: the length is the OUTPUT length, the
// "tls13 " prefix counts inside the label's length byte, and the context
// carries its own length even when empty. The RFC prints those bytes, so they
// can be asserted rather than inferred from a matching result.
//
// Exit 0 = all pass. Non-zero = the numbered check that failed.
// =======================================================

use "../tls/transcript.cst" as tr;
use "../tls/keysched.cst" as ks;
use "caustic-crypto/hash/sha2.cst" as sha2;
use "caustic-crypto/mac/hmac.cst" as hmac;

let is *u8 as EARLY with imut = "\x33\xad\x0a\x1c\x60\x7e\xc0\x3b\x09\xe6\xcd\x98\x93\x68\x0c\xe2\x10\xad\xf3\x00\xaa\x1f\x26\x60\xe1\xb2\x2e\x10\xf1\x70\xf9\x2a";
let is *u8 as DERIVED_HS with imut = "\x6f\x26\x15\xa1\x08\xc7\x02\xc5\x67\x8f\x54\xfc\x9d\xba\xb6\x97\x16\xc0\x76\x18\x9c\x48\x25\x0c\xeb\xea\xc3\x57\x6c\x36\x11\xba";
let is *u8 as HANDSHAKE with imut = "\x1d\xc8\x26\xe9\x36\x06\xaa\x6f\xdc\x0a\xad\xc1\x2f\x74\x1b\x01\x04\x6a\xa6\xb9\x9f\x69\x1e\xd2\x21\xa9\xf0\xca\x04\x3f\xbe\xac";
let is *u8 as ECDHE with imut = "\x8b\xd4\x05\x4f\xb5\x5b\x9d\x63\xfd\xfb\xac\xf9\xf0\x4b\x9f\x0d\x35\xe6\xd6\x3f\x53\x75\x63\xef\xd4\x62\x72\x90\x0f\x89\x49\x2d";
let is *u8 as C_HS with imut = "\xb3\xed\xdb\x12\x6e\x06\x7f\x35\xa7\x80\xb3\xab\xf4\x5e\x2d\x8f\x3b\x1a\x95\x07\x38\xf5\x2e\x96\x00\x74\x6a\x0e\x27\xa5\x5a\x21";
let is *u8 as S_HS with imut = "\xb6\x7b\x7d\x69\x0c\xc1\x6c\x4e\x75\xe5\x42\x13\xcb\x2d\x37\xb4\xe9\xc9\x12\xbc\xde\xd9\x10\x5d\x42\xbe\xfd\x59\xd3\x91\xad\x38";
let is *u8 as MASTER with imut = "\x18\xdf\x06\x84\x3d\x13\xa0\x8b\xf2\xa4\x49\x84\x4c\x5f\x8a\x47\x80\x01\xbc\x4d\x4c\x62\x79\x84\xd5\xa4\x1d\xa8\xd0\x40\x29\x19";
let is *u8 as C_AP with imut = "\x9e\x40\x64\x6c\xe7\x9a\x7f\x9d\xc0\x5a\xf8\x88\x9b\xce\x65\x52\x87\x5a\xfa\x0b\x06\xdf\x00\x87\xf7\x92\xeb\xb7\xc1\x75\x04\xa5";
let is *u8 as S_AP with imut = "\xa1\x1a\xf9\xf0\x55\x31\xf8\x56\xad\x47\x11\x6b\x45\xa9\x50\x32\x82\x04\xb4\xf4\x4b\xfb\x6b\x3a\x4b\x4f\x1f\x3f\xcb\x63\x16\x43";
let is *u8 as EXP with imut = "\xfe\x22\xf8\x81\x17\x6e\xda\x18\xeb\x8f\x44\x52\x9e\x67\x92\xc5\x0c\x9a\x3f\x89\x45\x2f\x68\xd8\xae\x31\x1b\x43\x09\xd3\xcf\x50";
let is *u8 as RES with imut = "\x7d\xf2\x35\xf2\x03\x1d\x2a\x05\x12\x87\xd0\x2b\x02\x41\xb0\xbf\xda\xf8\x6c\xc8\x56\x23\x1f\x2d\x5a\xba\x46\xc4\x34\xec\x19\x6c";
let is *u8 as TH_SH with imut = "\x86\x0c\x06\xed\xc0\x78\x58\xee\x8e\x78\xf0\xe7\x42\x8c\x58\xed\xd6\xb4\x3f\x2c\xa3\xe6\xe9\x5f\x02\xed\x06\x3c\xf0\xe1\xca\xd8";
let is *u8 as TH_SF with imut = "\x96\x08\x10\x2a\x0f\x1c\xcc\x6d\xb6\x25\x0b\x7b\x7e\x41\x7b\x1a\x00\x0e\xaa\xda\x3d\xaa\xe4\x77\x7a\x76\x86\xc9\xff\x83\xdf\x13";
let is *u8 as TH_CF with imut = "\x20\x91\x45\xa9\x6e\xe8\xe2\xa1\x22\xff\x81\x00\x47\xcc\x95\x26\x84\x65\x8d\x60\x49\xe8\x64\x29\x42\x6d\xb8\x7c\x54\xad\x14\x3d";
let is *u8 as EMPTY_HASH with imut = "\xe3\xb0\xc4\x42\x98\xfc\x1c\x14\x9a\xfb\xf4\xc8\x99\x6f\xb9\x24\x27\xae\x41\xe4\x64\x9b\x93\x4c\xa4\x95\x99\x1b\x78\x52\xb8\x55";
let is *u8 as INFO_DERIVED with imut = "\x00\x20\x0d\x74\x6c\x73\x31\x33\x20\x64\x65\x72\x69\x76\x65\x64\x20\xe3\xb0\xc4\x42\x98\xfc\x1c\x14\x9a\xfb\xf4\xc8\x99\x6f\xb9\x24\x27\xae\x41\xe4\x64\x9b\x93\x4c\xa4\x95\x99\x1b\x78\x52\xb8\x55";
let is *u8 as INFO_C_HS with imut = "\x00\x20\x12\x74\x6c\x73\x31\x33\x20\x63\x20\x68\x73\x20\x74\x72\x61\x66\x66\x69\x63\x20\x86\x0c\x06\xed\xc0\x78\x58\xee\x8e\x78\xf0\xe7\x42\x8c\x58\xed\xd6\xb4\x3f\x2c\xa3\xe6\xe9\x5f\x02\xed\x06\x3c\xf0\xe1\xca\xd8";
let is *u8 as S_HS_KEY with imut = "\x3f\xce\x51\x60\x09\xc2\x17\x27\xd0\xf2\xe4\xe8\x6e\xe4\x03\xbc";
let is *u8 as S_HS_IV with imut = "\x5d\x31\x3e\xb2\x67\x12\x76\xee\x13\x00\x0b\x30";
let is *u8 as C_HS_KEY with imut = "\xdb\xfa\xa6\x93\xd1\x76\x2c\x5b\x66\x6a\xf5\xd9\x50\x25\x8d\x01";
let is *u8 as C_HS_IV with imut = "\x5b\xd3\xc7\x1b\x83\x6e\x0b\x76\xbb\x73\x26\x5f";
let is *u8 as S_FIN_KEY with imut = "\x00\x8d\x3b\x66\xf8\x16\xea\x55\x9f\x96\xb5\x37\xe8\x85\xc3\x1f\xc0\x68\xbf\x49\x2c\x65\x2f\x01\xf2\x88\xa1\xd8\xcd\xc1\x9f\xc8";

let is i64 as INFO_DERIVED_N with imut = 49;
let is i64 as INFO_C_HS_N    with imut = 54;

fn eq(a as *u8, b as *u8, n as i64) as i64 {
    let is i64 as i with mut = 0;
    while (i < n) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn main() as i32 {
    let is [64]u8 as buf;
    let is [64]u8 as buf2;

    // The literal buffer in hkdf_expand_label is spelled out because CI builds
    // against the published toolchain, where a named dimension sizes an array
    // to nothing. Pin it to the constant that says how big it has to be.
    if (128 < ks.MAX_INFO) { return 1; }
    if (sizeof([128]u8) != 128) { return 2; }

    // ===== the transcript ============================================
    let is tr.Transcript as t;
    tr.tr_init(&t, tr.TR_SHA256);
    if (tr.tr_digest_len(&t) != 32) { return 3; }

    // The empty transcript hashes to SHA-256(""), which the schedule needs as
    // the context for every Derive-Secret with no messages in scope.
    tr.tr_digest(&t, cast(*u8, &buf));
    if (eq(cast(*u8, &buf), EMPTY_HASH, 32) == 0) { return 4; }
    tr.tr_empty_hash(tr.TR_SHA256, cast(*u8, &buf2));
    if (eq(cast(*u8, &buf2), EMPTY_HASH, 32) == 0) { return 5; }

    // Reading the transcript must NOT end it. Reading twice has to give the
    // same answer, and the second read has to still be the hash of what went
    // in — a destructive read would fold padding into the live state and every
    // message after it would hash into something the peer never had.
    tr.tr_update(&t, "abc", 3);
    tr.tr_digest(&t, cast(*u8, &buf));
    tr.tr_digest(&t, cast(*u8, &buf2));
    if (eq(cast(*u8, &buf), cast(*u8, &buf2), 32) == 0) { return 6; }

    let is [32]u8 as one;
    sha2.sha256("abc", 3, cast(*u8, &one));
    if (eq(cast(*u8, &buf), cast(*u8, &one), 32) == 0) { return 7; }

    // ...and the transcript keeps growing correctly after being read.
    tr.tr_update(&t, "def", 3);
    tr.tr_digest(&t, cast(*u8, &buf));
    sha2.sha256("abcdef", 6, cast(*u8, &one));
    if (eq(cast(*u8, &buf), cast(*u8, &one), 32) == 0) { return 8; }

    // ===== HkdfLabel, byte for byte ==================================
    // RFC 8448 prints the `info` fed to HKDF-Expand for each derivation, so
    // the encoding is checked directly rather than through a matching output.
    let is hmac.HashAlg as alg = hmac.alg_sha256();
    let is [128]u8 as info;

    if (ks.build_hkdf_label("derived", 7, EMPTY_HASH, 32, 32,
                            cast(*u8, &info), 128) != INFO_DERIVED_N) { return 9; }
    if (eq(cast(*u8, &info), INFO_DERIVED, INFO_DERIVED_N) == 0) { return 10; }

    if (ks.build_hkdf_label("c hs traffic", 12, TH_SH, 32, 32,
                            cast(*u8, &info), 128) != INFO_C_HS_N) { return 11; }
    if (eq(cast(*u8, &info), INFO_C_HS, INFO_C_HS_N) == 0) { return 12; }

    // ===== the chain =================================================
    let is ks.Secrets as s;

    ks.ks_early(&s, tr.TR_SHA256, cast(*u8, 0), 0);
    if (eq(cast(*u8, &s.early), EARLY, 32) == 0) { return 13; }

    // The "derived" step between early and handshake, on its own: it is the
    // one that takes the EMPTY TRANSCRIPT HASH as context, not an empty
    // context, and the two are three lines apart in the schedule.
    ks.derive_secret(&alg, cast(*u8, &s.early), "derived", EMPTY_HASH, cast(*u8, &buf));
    if (eq(cast(*u8, &buf), DERIVED_HS, 32) == 0) { return 14; }

    ks.ks_handshake(&s, ECDHE, 32, EMPTY_HASH, TH_SH);
    if (eq(cast(*u8, &s.handshake), HANDSHAKE, 32) == 0) { return 15; }
    if (eq(cast(*u8, &s.c_hs), C_HS, 32) == 0) { return 16; }
    if (eq(cast(*u8, &s.s_hs), S_HS, 32) == 0) { return 17; }

    ks.ks_application(&s, EMPTY_HASH, TH_SF, TH_CF);
    if (eq(cast(*u8, &s.master), MASTER, 32) == 0) { return 18; }
    if (eq(cast(*u8, &s.c_ap), C_AP, 32) == 0) { return 19; }
    if (eq(cast(*u8, &s.s_ap), S_AP, 32) == 0) { return 20; }
    if (eq(cast(*u8, &s.exp), EXP, 32) == 0) { return 21; }
    // res master takes the transcript through the CLIENT's Finished, not the
    // server's — a different message list, and a different secret.
    if (eq(cast(*u8, &s.res), RES, 32) == 0) { return 22; }

    // ===== traffic keys ==============================================
    // Here the context is genuinely EMPTY, not the empty transcript hash.
    let is [32]u8 as key;
    let is [12]u8 as iv;
    if (ks.ks_traffic_keys(&s, cast(*u8, &s.s_hs), cast(*u8, &key), 16,
                           cast(*u8, &iv), 12) != 0) { return 23; }
    if (eq(cast(*u8, &key), S_HS_KEY, 16) == 0) { return 24; }
    if (eq(cast(*u8, &iv), S_HS_IV, 12) == 0) { return 25; }

    if (ks.ks_traffic_keys(&s, cast(*u8, &s.c_hs), cast(*u8, &key), 16,
                           cast(*u8, &iv), 12) != 0) { return 26; }
    if (eq(cast(*u8, &key), C_HS_KEY, 16) == 0) { return 27; }
    if (eq(cast(*u8, &iv), C_HS_IV, 12) == 0) { return 28; }

    // ===== the Finished MAC key ======================================
    if (ks.ks_finished_key(&s, cast(*u8, &s.s_hs), cast(*u8, &buf)) != 0) { return 29; }
    if (eq(cast(*u8, &buf), S_FIN_KEY, 32) == 0) { return 30; }

    // ===== bounds ====================================================
    // A label past what the buffer was sized for is refused, not written.
    let is [96]u8 as toolong;
    let is i64 as i with mut = 0;
    while (i < 95) { toolong[i] = cast(u8, 120); i = i + 1; }
    toolong[95] = cast(u8, 0);
    if (ks.hkdf_expand_label(&alg, cast(*u8, &s.early), cast(*u8, &toolong), 95,
                             cast(*u8, 0), 0, cast(*u8, &buf), 32) != ks.KS_ERR_SPACE) { return 31; }
    if (ks.hkdf_expand_label(&alg, cast(*u8, &s.early), "x", 1,
                             EMPTY_HASH, 64, cast(*u8, &buf), 32) != ks.KS_ERR_SPACE) { return 32; }

    return 0;
}
