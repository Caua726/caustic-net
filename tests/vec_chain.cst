fn ch_host(i as i64) as *u8 { return _hs[i]; }
fn ch_want(i as i64) as i64 { return _want[i]; }
fn ch_len(i as i64) as i64 { return _clen[i]; }
fn ch_root(i as i64, len as *i64) as *u8 {
    *len = _rtlen[i];
    return _rt[i];
}
// A second anchor to put in the store BEFORE the real one, or null.
// Its subject DN has the same length and the same last two bytes as
// the real anchor's, which is exactly what trust_find_issuer compares
// before it compares the whole name.
fn ch_decoy(i as i64, len as *i64) as *u8 {
    *len = _dclen[i];
    return _dc[i];
}
fn ch_cert(i as i64, j as i64, len as *i64) as *u8 {
    *len = _certlen[i * CH_MAX + j];
    return _cert[i * CH_MAX + j];
}
