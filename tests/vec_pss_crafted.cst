let is i64 as PC_OK2048  with imut = 3;   // plain valid, SHA-256, salt 32
let is i64 as PC_ODDKEY  with imut = 0;   // the modBits == 1 mod 8 key
let is i64 as PC_SIGPLUSN with imut = 10;  // s >= n
let is i64 as PC_BIGSALT with imut = 11;   // valid, salt 513

