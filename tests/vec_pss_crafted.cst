// =======================================================
// caustic-net/tests/vec_pss_crafted.cst
// PSS signatures built from a chosen encoded message.
//
// GENERATED by tools/gen_pss_crafted.py from throwaway RSA keys; see
// that file for why the CAVP corpus cannot reach these cases and how
// to regenerate. Which keys they were does not matter.
//
// The message is the 64 bytes 0x00..0x3f for every vector.
//
//    0  emlen_k_minus_1    modBits == 1 mod 8, so emLen == k-1
//    1  over_embits        recovered EM needs more than emBits bits
//    2  topbits_set        leftmost 8*emLen-emBits bits of EM not zero
//    3  ok_2048_sha256     plain valid signature, salt == hLen
//    4  ok_2048_sha384     valid, SHA-384, salt == hLen
//    5  ok_2048_sha512     valid, SHA-512, salt == hLen
//    6  ok_salt_zero       valid with an empty salt: PS runs to the separator
//    7  bad_trailer        EM ends 0xbd instead of 0xbc
//    8  bad_ps             a PS byte is not zero
//    9  bad_sep            the 0x01 separator is zero
//   10  sig_plus_n         valid signature with n added: s >= n
//   11  salt_over_ceiling  valid, salt 513: only the ceiling refuses
// =======================================================

let is i64 as PC_COUNT with imut = 12;
