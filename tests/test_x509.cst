x2b\x06\x01\x05\x05\x07\x03\x02\x30\x1b\x06\x03\x55\x1d\x20\x04\x14\x30\x12\x30\x06\x06\x04\x55\x1d\x20\x00\x30\x08\x06\x06\x67\x81\x0c\x01\x02\x01\x30\x54\x06\x03\x55\x1d\x1f\x04\x4d\x30\x4b\x30\x49\xa0\x47\xa0\x45\x86\x43\x68\x74\x74\x70\x3a\x2f\x2f\x63\x72\x6c\x2e\x73\x65\x63\x74\x69\x67\x6f\x2e\x63\x6f\x6d\x2f\x53\x65\x63\x74\x69\x67\x6f\x50\x75\x62\x6c\x69\x63\x53\x65\x72\x76\x65\x72\x41\x75\x74\x68\x65\x6e\x74\x69\x63\x61\x74\x69\x6f\x6e\x52\x6f\x6f\x74\x45\x34\x36\x2e\x63\x72\x6c\x30\x81\x84\x06\x08\x2b\x06\x01\x05\x05\x07\x01\x01\x04\x78\x30\x76\x30\x4f\x06\x08\x2b\x06\x01\x05\x05\x07\x30\x02\x86\x43\x68\x74\x74\x70\x3a\x2f\x2f\x63\x72\x74\x2e\x73\x65\x63\x74\x69\x67\x6f\x2e\x63\x6f\x6d\x2f\x53\x65\x63\x74\x69\x67\x6f\x50\x75\x62\x6c\x69\x63\x53\x65\x72\x76\x65\x72\x41\x75\x74\x68\x65\x6e\x74\x69\x63\x61\x74\x69\x6f\x6e\x52\x6f\x6f\x74\x45\x34\x36\x2e\x70\x37\x63\x30\x23\x06\x08\x2b\x06\x01\x05\x05\x07\x30\x01\x86\x17\x68\x74\x74\x70\x3a\x2f\x2f\x6f\x63\x73\x70\x2e\x73\x65\x63\x74\x69\x67\x6f\x2e\x63\x6f\x6d\x30\x0a\x06\x08\x2a\x86\x48\xce\x3d\x04\x03\x03\x03\x67\x00\x30\x64\x02\x30\x5b\x0a\x9c\x14\x03\x87\xae\x25\xfa\xff\x9a\x51\x85\xa3\x0c\x22\x4a\x40\xcc\x47\x51\x41\xa6\x73\x00\x18\x0c\x88\xc9\xf6\x96\xd1\x60\x8b\x4c\x08\x8c\x79\xc6\xed\x28\x51\xbe\xac\x21\xf4\xd7\xa9\x02\x30\x3d\xd7\x5c\xb0\x31\x38\x29\xd7\x8b\xbb\x58\x49\x76\x91\xe0\x74\xbb\xec\x1c\x02\xb7\xbf\x28\x32\x2c\x6b\xa3\x31\x4f\x71\x04\x90\x83\x69\xc9\x11\x4f\xdd\xd5\x1c\x41\x34\x82\x9a\x60\x36\xa7\x55";
let is i64 as GH1_N with imut = 867;

fn streq(a as *u8, b as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (a[i] != 0 && b[i] != 0) { if (a[i] != b[i]) { return 0; } i = i + 1; }
    if (a[i] != b[i]) { return 0; }
    return 1;
}
fn slen(s as *u8) as i64 { let is i64 as n with mut = 0; while (s[n] != 0) { n = n + 1; } return n; }
fn m(pat as *u8, host as *u8) as i64 { return x509.name_matches(pat, slen(pat), host, slen(host)); }

fn main() as i32 {
    let is x509.Cert as leaf;
    let is x509.Cert as inter;
    let is x509.Cert as many;

    // ===== an EC leaf ================================================
    if (x509.cert_parse(LEAF, LEAF_N, &leaf) != 0) { return 1; }
    if (leaf.not_before != 1784584159) { return 2; }
    if (leaf.not_after != 1792363284) { return 3; }
    if (leaf.pk_alg != x509.PK_EC) { return 4; }
    if (leaf.curve != x509.CURVE_P256) { return 5; }
    if (leaf.sig_alg != x509.SIG_ECDSA_SHA256) { return 6; }
    if (leaf.is_ca != 0) { return 7; }
    if (leaf.has_bc != 1) { return 8; }
    // A leaf signs; it does not sign certificates. Reading the KeyUsage bits
    // the wrong way round — bit 0 is the MOST significant bit of the first
    // byte, so digitalSignature is 0x80 and not 1 — turns this inside out.
    if ((leaf.ku & x509.KU_DIGITAL_SIGNATURE) == 0) { return 9; }
    if ((leaf.ku & x509.KU_KEY_CERT_SIGN) != 0) { return 10; }
    if (leaf.tbs_len <= 0 || leaf.tbs_len >= LEAF_N) { return 11; }
    if (leaf.sig_len <= 0) { return 12; }
    // The TBS span starts at the very beginning of the certificate's own
    // SEQUENCE content and includes its header — it is what gets hashed.
    if (leaf.buf[leaf.tbs_off] != cast(u8, 0x30)) { return 13; }

    // ===== its SubjectAltName ========================================
    let is [512]u8 as nm;
    let is i64 as cur with mut = 0;
    let is i64 as kind with mut = 0;
    if (x509.cert_san_next(&leaf, &cur, cast(*u8, &nm), 512, &kind) <= 0) { return 14; }
    if (kind != x509.GN_DNSNAME) { return 15; }
    if (streq(cast(*u8, &nm), "ietf.org") == 0) { return 16; }

    let is i64 as n with mut = 0;
    cur = 0;
    while (x509.cert_san_next(&leaf, &cur, cast(*u8, &nm), 512, &kind) > 0) { n = n + 1; }
    if (n != 2) { return 17; }

    // ===== hostname matching, SAN only ===============================
    if (x509.cert_name_matches(&leaf, "ietf.org") != 1) { return 18; }
    if (x509.cert_name_matches(&leaf, "IETF.ORG") != 1) { return 19; }
    if (x509.cert_name_matches(&leaf, "nao-esta-no-san.invalid") != 0) { return 20; }
    // A prefix of a listed name is a different name.
    if (x509.cert_name_matches(&leaf, "ietf.or") != 0) { return 21; }

    // ===== the issuer ================================================
    if (x509.cert_parse(INTER, INTER_N, &inter) != 0) { return 22; }
    if (inter.is_ca != 1) { return 23; }
    // A CA signs certificates; that is what makes it one, and the bit says so.
    if ((inter.ku & x509.KU_KEY_CERT_SIGN) == 0) { return 24; }
    if (inter.not_after <= inter.not_before) { return 25; }

    // The chain: the leaf's issuer Name is the intermediate's subject Name,
    // byte for byte.
    if (x509.cert_issued_by(&leaf, &inter) != 1) { return 26; }
    // ...and not the other way round, nor is either self-signed.
    if (x509.cert_issued_by(&inter, &leaf) != 0) { return 27; }
    if (x509.cert_is_self_signed(&leaf) != 0) { return 28; }

    // ===== a leaf with 163 names ====================================
    // Iteration has to reach the last one. A parser that stops early, or that
    // collects into a fixed array, answers "no" for a host the certificate
    // genuinely covers.
    if (x509.cert_parse(MANY, MANY_N, &many) != 0) { return 29; }
    if (many.pk_alg != x509.PK_RSA) { return 30; }
    if (many.rsa_n_len <= 0) { return 31; }
    if (many.rsa_e_len <= 0) { return 32; }
    if (many.sig_alg != x509.SIG_RSA_SHA384) { return 33; }
    n = 0;
    cur = 0;
    while (x509.cert_san_next(&many, &cur, cast(*u8, &nm), 512, &kind) > 0) { n = n + 1; }
    if (n != 163) { return 34; }
    if (x509.cert_name_matches(&many, "microsoft.com") != 1) { return 35; }
    if (x509.cert_name_matches(&many, "cdn.techcommunity.microsoft.com") != 1) { return 36; }

    // ===== wildcard rules — RFC 6125 §6.4 ============================
    // Every one of these is a real implementation bug that shipped somewhere,
    // and each lets one certificate answer for a host it was not issued for.
    if (m("*.a.com", "x.a.com") != 1) { return 37; }
    if (m("*.a.com", "X.A.com") != 1) { return 38; }
    // The wildcard consumes exactly one label: not zero...
    if (m("*.a.com", "a.com") != 0) { return 39; }
    // ...and not two.
    if (m("*.a.com", "x.y.a.com") != 0) { return 40; }
    // It must be the WHOLE leftmost label.
    if (m("x*.a.com", "xy.a.com") != 0) { return 41; }
    if (m("*x.a.com", "yx.a.com") != 0) { return 43; }
    // The sharp one: skipping the "*" and one more byte leaves "a.com", which
    // lines up exactly with the tail of "y.a.com". Without the requirement
    // that a "." follow the wildcard, a certificate for "*xa.com" answers for
    // "y.a.com" — a different registrable domain.
    if (m("*xa.com", "y.a.com") != 0) { return 42; }
    // Only one wildcard.
    if (m("*.*.com", "x.y.com") != 0) { return 64; }
    // Not in the middle or at the end.
    if (m("a.*.com", "a.x.com") != 0) { return 44; }
    // A wildcard covering a public suffix would cover every domain under it.
    if (m("*.com", "example.com") != 0) { return 45; }

    // Exact matching, case-insensitive, and a trailing dot is not part of the
    // name on either side.
    if (m("a.com", "a.com") != 1) { return 46; }
    if (m("A.CoM", "a.com") != 1) { return 47; }
    if (m("a.com.", "a.com") != 1) { return 48; }
    if (m("a.com", "a.com.") != 1) { return 49; }
    if (m("a.com", "b.com") != 0) { return 50; }
    if (m("a.com", "a.co") != 0) { return 51; }
    if (m("a.com", "xa.com") != 0) { return 52; }

    // An embedded NUL is the classic forgery: "bank.com\0evil.com" reads as
    // the bank to anything that stops at a terminator. Everything here works
    // on lengths, and a name carrying one is refused outright.
    if (x509.name_matches("a.com\x00evil.com", 15, "a.com", 5) != 0) { return 53; }
    if (x509.name_matches("a.com", 5, "a.com\x00evil.com", 15) != 0) { return 54; }

    // ===== a critical extension nobody understands ===================
    // §4.2: an unrecognised extension marked critical means the certificate
    // MUST be rejected — the flag is the CA saying "if you cannot enforce
    // this, do not trust me". Silently ignoring it accepts a certificate whose
    // constraints were never applied.
    //
    // No real certificate carries one, so this is a real certificate with one
    // byte changed: basicConstraints' OID 2.5.29.19 became 2.5.29.153, same
    // length, critical flag untouched. The signature no longer verifies, which
    // does not matter — parsing has to refuse it before anyone gets that far.
    let is x509.Cert as ce;
    if (x509.cert_parse(CRITEXT, CRITEXT_N, &ce) != x509.X509_ERR_CRITEXT) { return 57; }

    // ===== issuer matching is by BYTES, not by length =================
    // These two Names are both 98 bytes and are different Names. A comparison
    // that stopped at the length would build a chain out of unrelated
    // certificates — and then verify a signature against the wrong key, which
    // fails, so the symptom is an unverifiable chain rather than a false trust.
    let is x509.Cert as a;
    let is x509.Cert as g;
    if (x509.cert_parse(AMZ, AMZ_N, &a) != 0) { return 58; }
    if (x509.cert_parse(GH1, GH1_N, &g) != 0) { return 59; }
    if (a.issuer_len != g.subject_len) { return 60; }
    if (x509.cert_issued_by(&a, &g) != 0) { return 61; }

    // ===== a bare "*" is not a pattern ===============================
    // With no dot after it there is no suffix to compare, and a wildcard path
    // that assumes one reads past the end of the pattern.
    if (m("*", "a.com") != 0) { return 62; }
    if (m("*.", "a.com") != 0) { return 63; }

    // ===== truncated input ===========================================
    // Every prefix of a real certificate must be refused rather than read into
    // whatever follows the buffer.
    let is i64 as cut with mut = 8;
    let is x509.Cert as t;
    while (cut < LEAF_N) {
        if (x509.cert_parse(LEAF, cut, &t) >= 0) { return 55; }
        cut = cut + 37;
    }
    if (x509.cert_parse(LEAF, 0, &t) >= 0) { return 56; }

    return 0;
}
