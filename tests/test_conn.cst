// =======================================================
// caustic-net/tests/test_conn.cst
// De-risks the keystone: a mock Conn whose vtable reads/writes
// an in-memory buffer (no socket). Proves fn_ptr/call dispatch
// compiles and routes correctly through core/conn.cst.
//
// Exit 0 = all pass. Non-zero = the numbered check that failed.
// =======================================================

use "std/mem.cst" only core as mem;
use "../core/conn.cst" as conn;

// Mock pipe: writes append at `len`, reads consume from `rpos`.
struct MockCtx {
    buf  as *u8;
    len  as i64;
    rpos as i64;
    st   as i64;
}

fn _mock_read(ctx as *u8, out as *u8, n as i64) as i64 {
    let is *MockCtx as m = cast(*MockCtx, ctx);
    let is i64 as avail = m.len - m.rpos;
    if (avail <= 0) { return 0; }
    let is i64 as k with mut = n;
    if (k > avail) { k = avail; }
    mem.core.memcpy(out, cast(*u8, cast(i64, m.buf) + m.rpos), k);
    m.rpos = m.rpos + k;
    return k;
}

fn _mock_write(ctx as *u8, in as *u8, n as i64) as i64 {
    let is *MockCtx as m = cast(*MockCtx, ctx);
    mem.core.memcpy(cast(*u8, cast(i64, m.buf) + m.len), in, n);
    m.len = m.len + n;
    return n;
}

fn _mock_close(ctx as *u8) as i64 {
    let is *MockCtx as m = cast(*MockCtx, ctx);
    m.st = conn.CONN_CLOSED;
    return 0;
}

fn _mock_state(ctx as *u8) as i64 {
    let is *MockCtx as m = cast(*MockCtx, ctx);
    return m.st;
}

fn main() as i32 {
    let is [256]u8 as storage;
    let is MockCtx as m;
    m.buf = cast(*u8, &storage);
    m.len = 0;
    m.rpos = 0;
    m.st = conn.CONN_OPEN;

    let is conn.Conn as c;
    c.ctx   = cast(*u8, &m);
    c.read  = fn_ptr(_mock_read);
    c.write = fn_ptr(_mock_write);
    c.close = fn_ptr(_mock_close);
    c.state = fn_ptr(_mock_state);

    // 1: single write dispatches and reports full count
    let is i64 as w = conn.conn_write(&c, "hello", 5);
    if (w != 5) { return 1; }

    // 2/3/4: read back through the vtable
    let is [16]u8 as rb;
    let is i64 as r = conn.conn_read(&c, cast(*u8, &rb), 16);
    if (r != 5) { return 2; }
    if (rb[0] != 104) { return 3; }   // 'h'
    if (rb[4] != 111) { return 4; }   // 'o'

    // 5: read past EOF returns 0
    let is i64 as r2 = conn.conn_read(&c, cast(*u8, &rb), 16);
    if (r2 != 0) { return 5; }

    // 6/7: conn_write_all + conn_read_exact loop helpers
    let is i64 as w2 = conn.conn_write_all(&c, "abcdefgh", 8);
    if (w2 != 8) { return 6; }
    let is [8]u8 as rb2;
    let is i64 as r3 = conn.conn_read_exact(&c, cast(*u8, &rb2), 8);
    if (r3 != 8) { return 7; }
    if (rb2[7] != 104) { return 8; }   // 'h'

    // 9/10: state slot before/after close
    if (conn.conn_state(&c) != conn.CONN_OPEN) { return 9; }
    conn.conn_close(&c);
    if (conn.conn_state(&c) != conn.CONN_CLOSED) { return 10; }

    return 0;
}
