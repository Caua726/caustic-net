fn pv_ensure() as void {
    if (_ready == 0) { _fill(); _ready = 1; }
}

fn pv_n(i as i64) as *u8 { return _n[i]; }
fn pv_nlen(i as i64) as i64 { return _nlen[i]; }
fn pv_e(i as i64) as *u8 { return _e[i]; }
fn pv_elen(i as i64) as i64 { return _elen[i]; }
fn pv_msg(i as i64) as *u8 { return _m[i]; }
fn pv_mlen(i as i64) as i64 { return _mlen[i]; }
fn pv_sig(i as i64) as *u8 { return _s[i]; }
fn pv_siglen(i as i64) as i64 { return _siglen[i]; }
fn pv_sha(i as i64) as i64 { return _sha[i]; }
fn pv_salt(i as i64) as i64 { return _salt[i]; }
fn pv_want(i as i64) as i64 { return _want[i]; }
fn pv_reason(i as i64) as i64 { return _reason[i]; }
