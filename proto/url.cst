// =======================================================
// caustic-net/proto/url.cst
// URL parsing — the first thing fetch() does with its argument.
//
// Zero-copy and zero-alloc: a parsed Url holds offsets into the
// caller's string, never a copy. The string must outlive the Url.
// Accessors copy a part out only when someone actually wants it.
//
// The grammar is the HTTP subset of RFC 3986:
//   scheme "://" [userinfo "@"] host [":" port] path ["?" query] ["#" frag]
// An IPv6 literal host is accepted in brackets — [::1]:8080 — and the
// brackets are kept OUT of the host part, so a connect sees "::1" while
// the Host header can put them back.
// =======================================================

// Sentinels, in the same range as the other caustic-net codes (errno.cst uses
// -1000, bufread -1100) so they can never be mistaken for a -errno.
let is i64 as URL_ERR_EMPTY  with imut = 0 - 1200;   // nothing to parse
let is i64 as URL_ERR_SCHEME with imut = 0 - 1201;   // missing or malformed scheme://
let is i64 as URL_ERR_HOST   with imut = 0 - 1202;   // empty host, or unclosed '['
let is i64 as URL_ERR_PORT   with imut = 0 - 1203;   // non-digit, empty, or > 65535
let is i64 as URL_ERR_SPACE  with imut = 0 - 1204;   // caller's buffer too small

struct Url {
    ok  as i64;    // 0 parsed, else one of URL_ERR_*
    src as *u8;    // the string this was parsed from — offsets index into it

    scheme_off as i64;   scheme_len as i64;
    user_off   as i64;   user_len   as i64;   // userinfo before '@', len 0 when absent
    host_off   as i64;   host_len   as i64;   // no brackets, even for IPv6
    path_off   as i64;   path_len   as i64;   // len 0 when absent; means "/"
    query_off  as i64;   query_len  as i64;   // without the '?'
    frag_off   as i64;   frag_len   as i64;   // without the '#'

    port as i64;   // explicit, or the scheme default, or 0 if neither
    tls  as i64;   // 1 for https/wss — whether a TLS Conn must wrap the TCP one
    ip6  as i64;   // 1 when the host was a bracketed IPv6 literal
}

fn _lower(c as u8) as u8 {
    if (c >= 65 && c <= 90) { return cast(u8, cast(i64, c) + 32); }
    return c;
}

fn _is_digit(c as u8) as i64 {
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}

fn _is_alpha(c as u8) as i64 {
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    return 0;
}

fn _slen(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

// Case-insensitive compare of src[off..off+len) against a NUL-terminated s.
// Schemes and hosts are case-insensitive per RFC 3986, so HTTPS://X == https://x.
fn _ci_eq(src as *u8, off as i64, len as i64, s as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (i < len) {
        if (s[i] == 0) { return 0; }
        if (_lower(src[off + i]) != _lower(s[i])) { return 0; }
        i = i + 1;
    }
    if (s[i] != 0) { return 0; }
    return 1;
}

// The port a scheme implies when the URL does not say one. 0 when unknown.
fn default_port(scheme as *u8) as i64 {
    let is i64 as n = _slen(scheme);
    if (_ci_eq(scheme, 0, n, "http")  == 1) { return 80; }
    if (_ci_eq(scheme, 0, n, "https") == 1) { return 443; }
    if (_ci_eq(scheme, 0, n, "ws")    == 1) { return 80; }
    if (_ci_eq(scheme, 0, n, "wss")   == 1) { return 443; }
    return 0;
}

// The default port for an already-parsed Url's scheme.
fn _url_default_port(u as *Url) as i64 {
    if (_ci_eq(u.src, u.scheme_off, u.scheme_len, "http")  == 1) { return 80; }
    if (_ci_eq(u.src, u.scheme_off, u.scheme_len, "https") == 1) { return 443; }
    if (_ci_eq(u.src, u.scheme_off, u.scheme_len, "ws")    == 1) { return 80; }
    if (_ci_eq(u.src, u.scheme_off, u.scheme_len, "wss")   == 1) { return 443; }
    return 0;
}

// Parse `s` (NUL-terminated). The Url is only meaningful when .ok == 0.
fn url_parse(s as *u8) as Url {
    let is Url as u;
    u.ok = 0;
    u.src = s;
    u.scheme_off = 0; u.scheme_len = 0;
    u.user_off = 0;   u.user_len = 0;
    u.host_off = 0;   u.host_len = 0;
    u.path_off = 0;   u.path_len = 0;
    u.query_off = 0;  u.query_len = 0;
    u.frag_off = 0;   u.frag_len = 0;
    u.port = 0; u.tls = 0; u.ip6 = 0;

    if (cast(i64, s) == 0) { u.ok = URL_ERR_EMPTY; return u; }
    let is i64 as n = _slen(s);
    if (n == 0) { u.ok = URL_ERR_EMPTY; return u; }

    // --- scheme: ALPHA *( ALPHA / DIGIT / "+" / "-" / "." ) "://" ---
    if (_is_alpha(s[0]) == 0) { u.ok = URL_ERR_SCHEME; return u; }
    let is i64 as i with mut = 0;
    while (i < n) {
        let is u8 as c = s[i];
        if (_is_alpha(c) == 1 || _is_digit(c) == 1 || c == 43 || c == 45 || c == 46) {
            i = i + 1;
        } else { break; }
    }
    if (i + 2 >= n) { u.ok = URL_ERR_SCHEME; return u; }
    if (s[i] != 58 || s[i + 1] != 47 || s[i + 2] != 47) {          // "://"
        u.ok = URL_ERR_SCHEME; return u;
    }
    u.scheme_off = 0;
    u.scheme_len = i;
    i = i + 3;

    // --- authority runs to the first '/', '?' or '#' ---
    let is i64 as auth_start = i;
    while (i < n && s[i] != 47 && s[i] != 63 && s[i] != 35) { i = i + 1; }
    let is i64 as auth_end = i;
    if (auth_end == auth_start) { u.ok = URL_ERR_HOST; return u; }

    // userinfo: everything before the LAST '@' in the authority. A password may
    // legally contain an encoded '@', so the last one is the real delimiter.
    let is i64 as at with mut = 0 - 1;
    let is i64 as j with mut = auth_start;
    while (j < auth_end) {
        if (s[j] == 64) { at = j; }                                // '@'
        j = j + 1;
    }
    let is i64 as host_start with mut = auth_start;
    if (at >= 0) {
        u.user_off = auth_start;
        u.user_len = at - auth_start;
        host_start = at + 1;
    }
    if (host_start >= auth_end) { u.ok = URL_ERR_HOST; return u; }

    // host: a bracketed IPv6 literal, or everything up to the ':' before a port
    let is i64 as port_sep with mut = 0 - 1;
    if (s[host_start] == 91) {                                     // '['
        let is i64 as close with mut = 0 - 1;
        let is i64 as k with mut = host_start + 1;
        while (k < auth_end) {
            if (s[k] == 93) { close = k; break; }                  // ']'
            k = k + 1;
        }
        if (close < 0) { u.ok = URL_ERR_HOST; return u; }
        u.ip6 = 1;
        u.host_off = host_start + 1;                               // strip the brackets
        u.host_len = close - host_start - 1;
        if (close + 1 < auth_end) {
            if (s[close + 1] != 58) { u.ok = URL_ERR_HOST; return u; }
            port_sep = close + 1;
        }
    } else {
        // A ':' here is unambiguous: a bare IPv6 address would have needed
        // brackets, so the first colon starts the port.
        let is i64 as k with mut = host_start;
        while (k < auth_end) {
            if (s[k] == 58) { port_sep = k; break; }               // ':'
            k = k + 1;
        }
        u.host_off = host_start;
        if (port_sep >= 0) { u.host_len = port_sep - host_start; }
        else { u.host_len = auth_end - host_start; }
    }
    if (u.host_len <= 0) { u.ok = URL_ERR_HOST; return u; }

    // port: digits only, and it has to fit in a u16
    if (port_sep >= 0) {
        let is i64 as k with mut = port_sep + 1;
        if (k >= auth_end) { u.ok = URL_ERR_PORT; return u; }      // "host:" with nothing
        let is i64 as p with mut = 0;
        while (k < auth_end) {
            if (_is_digit(s[k]) == 0) { u.ok = URL_ERR_PORT; return u; }
            p = p * 10 + (cast(i64, s[k]) - 48);
            if (p > 65535) { u.ok = URL_ERR_PORT; return u; }
            k = k + 1;
        }
        u.port = p;
    }

    // --- path / query / fragment ---
    let is i64 as path_start = i;
    while (i < n && s[i] != 63 && s[i] != 35) { i = i + 1; }
    u.path_off = path_start;
    u.path_len = i - path_start;

    if (i < n && s[i] == 63) {                                     // '?'
        i = i + 1;
        let is i64 as q = i;
        while (i < n && s[i] != 35) { i = i + 1; }
        u.query_off = q;
        u.query_len = i - q;
    }
    if (i < n && s[i] == 35) {                                     // '#'
        i = i + 1;
        u.frag_off = i;
        u.frag_len = n - i;
    }

    // scheme-derived defaults
    if (_ci_eq(s, u.scheme_off, u.scheme_len, "https") == 1) { u.tls = 1; }
    if (_ci_eq(s, u.scheme_off, u.scheme_len, "wss")   == 1) { u.tls = 1; }
    if (u.port == 0) { u.port = _url_default_port(&u); }
    return u;
}

// --- part accessors: copy out NUL-terminated, return length or URL_ERR_SPACE ---

fn _copy_part(u as *Url, off as i64, len as i64, out as *u8, max as i64) as i64 {
    if (len + 1 > max) { return URL_ERR_SPACE; }
    let is i64 as i with mut = 0;
    while (i < len) { out[i] = u.src[off + i]; i = i + 1; }
    out[len] = cast(u8, 0);
    return len;
}

fn url_scheme(u as *Url, out as *u8, max as i64) as i64 {
    return _copy_part(u, u.scheme_off, u.scheme_len, out, max);
}

// The host with no brackets — what a DNS lookup or a connect wants.
fn url_host(u as *Url, out as *u8, max as i64) as i64 {
    return _copy_part(u, u.host_off, u.host_len, out, max);
}

fn url_user(u as *Url, out as *u8, max as i64) as i64 {
    return _copy_part(u, u.user_off, u.user_len, out, max);
}

fn url_query(u as *Url, out as *u8, max as i64) as i64 {
    return _copy_part(u, u.query_off, u.query_len, out, max);
}

fn url_fragment(u as *Url, out as *u8, max as i64) as i64 {
    return _copy_part(u, u.frag_off, u.frag_len, out, max);
}

// The path, defaulting to "/" when the URL had none.
fn url_path(u as *Url, out as *u8, max as i64) as i64 {
    if (u.path_len == 0) {
        if (max < 2) { return URL_ERR_SPACE; }
        out[0] = cast(u8, 47);                                     // '/'
        out[1] = cast(u8, 0);
        return 1;
    }
    return _copy_part(u, u.path_off, u.path_len, out, max);
}

// What goes on the HTTP request line: path + "?" + query, with the same "/"
// default. This is origin-form; a proxy would want absolute-form instead.
// The fragment is deliberately absent — it never goes on the wire.
fn url_request_target(u as *Url, out as *u8, max as i64) as i64 {
    let is i64 as need with mut = u.path_len;
    if (need == 0) { need = 1; }                                   // the implicit "/"
    if (u.query_len > 0) { need = need + 1 + u.query_len; }
    if (need + 1 > max) { return URL_ERR_SPACE; }

    let is i64 as w with mut = 0;
    if (u.path_len == 0) { out[0] = cast(u8, 47); w = 1; }
    else {
        while (w < u.path_len) { out[w] = u.src[u.path_off + w]; w = w + 1; }
    }
    if (u.query_len > 0) {
        out[w] = cast(u8, 63); w = w + 1;                          // '?'
        let is i64 as i with mut = 0;
        while (i < u.query_len) { out[w] = u.src[u.query_off + i]; w = w + 1; i = i + 1; }
    }
    out[w] = cast(u8, 0);
    return w;
}

// The Host header value: host, plus ":port" ONLY when the port is not the
// scheme's default — which is what RFC 9110 asks for, and what a virtual host
// is matched against. An IPv6 literal gets its brackets back here.
fn url_host_header(u as *Url, out as *u8, max as i64) as i64 {
    let is i64 as defp = _url_default_port(u);

    let is i64 as show_port with mut = 0;
    if (u.port != 0 && u.port != defp) { show_port = 1; }

    let is i64 as need with mut = u.host_len;
    if (u.ip6 == 1) { need = need + 2; }

    let is [8]u8 as digits;
    let is i64 as dn with mut = 0;
    if (show_port == 1) {
        let is i64 as p with mut = u.port;
        while (p > 0) { digits[dn] = cast(u8, 48 + (p % 10)); dn = dn + 1; p = p / 10; }
        need = need + 1 + dn;
    }
    if (need + 1 > max) { return URL_ERR_SPACE; }

    let is i64 as w with mut = 0;
    if (u.ip6 == 1) { out[w] = cast(u8, 91); w = w + 1; }          // '['
    let is i64 as i with mut = 0;
    while (i < u.host_len) { out[w] = u.src[u.host_off + i]; w = w + 1; i = i + 1; }
    if (u.ip6 == 1) { out[w] = cast(u8, 93); w = w + 1; }          // ']'
    if (show_port == 1) {
        out[w] = cast(u8, 58); w = w + 1;                          // ':'
        while (dn > 0) { dn = dn - 1; out[w] = digits[dn]; w = w + 1; }
    }
    out[w] = cast(u8, 0);
    return w;
}

fn url_scheme_is(u as *Url, s as *u8) as i64 {
    return _ci_eq(u.src, u.scheme_off, u.scheme_len, s);
}

fn url_host_is(u as *Url, s as *u8) as i64 {
    return _ci_eq(u.src, u.host_off, u.host_len, s);
}

// --- percent-encoding ---

fn _hex_val(c as u8) as i64 {
    if (c >= 48 && c <= 57)  { return cast(i64, c) - 48; }
    if (c >= 65 && c <= 70)  { return cast(i64, c) - 55; }
    if (c >= 97 && c <= 102) { return cast(i64, c) - 87; }
    return 0 - 1;
}

// Decode %XX from src[0..len) into out. Returns the decoded length, or
// URL_ERR_SPACE. A stray '%' not followed by two hex digits passes through as
// a literal '%' — browsers tolerate that rather than rejecting the whole URL.
fn pct_decode(src as *u8, len as i64, out as *u8, max as i64) as i64 {
    let is i64 as i with mut = 0;
    let is i64 as w with mut = 0;
    while (i < len) {
        if (src[i] == 37 && i + 2 < len) {                          // '%'
            let is i64 as hi = _hex_val(src[i + 1]);
            let is i64 as lo = _hex_val(src[i + 2]);
            if (hi >= 0 && lo >= 0) {
                if (w + 1 >= max) { return URL_ERR_SPACE; }
                out[w] = cast(u8, hi * 16 + lo);
                w = w + 1;
                i = i + 3;
                continue;
            }
        }
        if (w + 1 >= max) { return URL_ERR_SPACE; }
        out[w] = src[i];
        w = w + 1;
        i = i + 1;
    }
    if (w >= max) { return URL_ERR_SPACE; }
    out[w] = cast(u8, 0);
    return w;
}

// Unreserved per RFC 3986: ALPHA / DIGIT / "-" / "." / "_" / "~"
fn _unreserved(c as u8) as i64 {
    if (_is_alpha(c) == 1 || _is_digit(c) == 1) { return 1; }
    if (c == 45 || c == 46 || c == 95 || c == 126) { return 1; }
    return 0;
}

// Percent-encode everything that is not unreserved — the right rule for ONE
// query-string component, where '&' and '=' are separators and must not pass
// through raw. Returns the encoded length, or URL_ERR_SPACE.
fn pct_encode(src as *u8, len as i64, out as *u8, max as i64) as i64 {
    let is *u8 as hex = "0123456789ABCDEF";
    let is i64 as i with mut = 0;
    let is i64 as w with mut = 0;
    while (i < len) {
        let is u8 as c = src[i];
        if (_unreserved(c) == 1) {
            if (w + 1 >= max) { return URL_ERR_SPACE; }
            out[w] = c;
            w = w + 1;
        } else {
            if (w + 3 >= max) { return URL_ERR_SPACE; }
            out[w] = cast(u8, 37);                                  // '%'
            out[w + 1] = hex[(cast(i64, c) >> 4) & 15];
            out[w + 2] = hex[cast(i64, c) & 15];
            w = w + 3;
        }
        i = i + 1;
    }
    if (w >= max) { return URL_ERR_SPACE; }
    out[w] = cast(u8, 0);
    return w;
}

// =======================================================
// Relative reference resolution — RFC 3986 §5.2
//
// A Location header is allowed to be relative, and in practice usually is:
// "/login", "../two", "?page=2", even "". url_parse rejects all of those,
// correctly — they are references, not URLs. Resolving one against the URL it
// arrived from is what turns it back into something connectable.
//
// The result cannot borrow from either input, because it is made of pieces of
// both, so this is the one place in the module that writes a whole URL out. The
// returned Url points into `out`, which the caller must keep alive — the same
// contract url_parse has with its argument.
// =======================================================

// A reference split into its five components. A length of -1 means ABSENT,
// which §5.2.2 must tell apart from present-and-empty: "http://h" has no query,
// "http://h?" has an empty one, and they resolve differently.
struct RefParts {
    sc_off as i64;   sc_len as i64;
    au_off as i64;   au_len as i64;
    pa_off as i64;   pa_len as i64;
    qu_off as i64;   qu_len as i64;
    fr_off as i64;   fr_len as i64;
}

// Does `s` begin with a scheme? ALPHA *( ALPHA / DIGIT / "+" / "-" / "." ) ":"
// — so "http:" does, while "/a:b" and "a/b:c" do not, since the first character
// outside the set decides before any ':' is reached.
fn _ref_has_scheme(s as *u8, n as i64) as i64 {
    if (n == 0) { return 0; }
    if (_is_alpha(s[0]) == 0) { return 0; }
    let is i64 as i with mut = 1;
    while (i < n) {
        let is u8 as c = s[i];
        if (c == 58) { return 1; }                                   // ':'
        if (_is_alpha(c) == 0 && _is_digit(c) == 0
            && c != 43 && c != 45 && c != 46) { return 0; }          // '+' '-' '.'
        i = i + 1;
    }
    return 0;
}

fn _split_ref(s as *u8, n as i64) as RefParts {
    let is RefParts as p;
    p.sc_off = 0; p.sc_len = 0 - 1;
    p.au_off = 0; p.au_len = 0 - 1;
    p.pa_off = 0; p.pa_len = 0;
    p.qu_off = 0; p.qu_len = 0 - 1;
    p.fr_off = 0; p.fr_len = 0 - 1;

    let is i64 as i with mut = 0;
    if (_ref_has_scheme(s, n) == 1) {
        while (s[i] != 58) { i = i + 1; }
        p.sc_off = 0; p.sc_len = i;
        i = i + 1;                                                   // past ':'
    }
    if (i + 1 < n && s[i] == 47 && s[i + 1] == 47) {                 // "//"
        i = i + 2;
        let is i64 as a = i;
        while (i < n && s[i] != 47 && s[i] != 63 && s[i] != 35) { i = i + 1; }
        p.au_off = a; p.au_len = i - a;
    }
    let is i64 as ps = i;
    while (i < n && s[i] != 63 && s[i] != 35) { i = i + 1; }
    p.pa_off = ps; p.pa_len = i - ps;

    if (i < n && s[i] == 63) {
        i = i + 1;
        let is i64 as q = i;
        while (i < n && s[i] != 35) { i = i + 1; }
        p.qu_off = q; p.qu_len = i - q;
    }
    if (i < n && s[i] == 35) {
        i = i + 1;
        p.fr_off = i; p.fr_len = n - i;
    }
    return p;
}

// RFC 3986 §5.2.4, in place over buf[0..n). Returns the new length. The output
// is never longer than the input and the write cursor never overtakes the read
// cursor, so one buffer does.
fn _remove_dot_segments(buf as *u8, n as i64) as i64 {
    let is i64 as r with mut = 0;
    let is i64 as w with mut = 0;
    while (r < n) {
        if (buf[r] != 47) {
            // A first segment with no leading '/'. Only reachable for a
            // relative base, which an http(s) URL never has.
            while (r < n && buf[r] != 47) { buf[w] = buf[r]; w = w + 1; r = r + 1; }
        } else {
            let is i64 as seg = r + 1;
            let is i64 as e with mut = seg;
            while (e < n && buf[e] != 47) { e = e + 1; }
            let is i64 as sl = e - seg;

            let is i64 as dot with mut = 0;
            let is i64 as dotdot with mut = 0;
            if (sl == 1 && buf[seg] == 46) { dot = 1; }
            if (sl == 2 && buf[seg] == 46 && buf[seg + 1] == 46) { dotdot = 1; }

            if (dot == 1) {
                // "/." contributes nothing, but "/a/." still ends in a slash.
                if (e >= n) { buf[w] = 47; w = w + 1; }
            } else if (dotdot == 1) {
                // Drop the last segment written, its leading '/' included.
                while (w > 0) { w = w - 1; if (buf[w] == 47) { break; } }
                if (e >= n) { buf[w] = 47; w = w + 1; }
            } else {
                buf[w] = 47; w = w + 1;
                let is i64 as k with mut = 0;
                while (k < sl) { buf[w] = buf[seg + k]; w = w + 1; k = k + 1; }
            }
            r = e;
        }
    }
    return w;
}

// Resolve `ref` against `base` into `out`, then parse the result. `ref` may be
// absolute, network-path ("//h/p"), absolute-path ("/p"), relative ("../p"),
// query-only ("?x=1"), fragment-only ("#f") or empty.
//
// Returns a Url with .ok == 0 on success, URL_ERR_SPACE when `out` is too
// small, or whatever `base` failed with — resolving against a base that never
// parsed cannot produce an answer.
fn url_resolve(base as *Url, ref as *u8, out as *u8, max as i64) as Url {
    if (base.ok != 0) {
        let is Url as bad;
        bad.ok = base.ok;
        return bad;
    }
    let is i64 as n = _slen(ref);
    let is RefParts as p = _split_ref(ref, n);

    let is i64 as w with mut = 0;

    // --- scheme: the reference's when it has one, otherwise the base's ---
    let is *u8 as sc_src with mut = base.src;
    let is i64 as sc_off with mut = base.scheme_off;
    let is i64 as sc_len with mut = base.scheme_len;
    if (p.sc_len >= 0) { sc_src = ref; sc_off = p.sc_off; sc_len = p.sc_len; }
    if (w + sc_len + 3 > max) { let is Url as e; e.ok = URL_ERR_SPACE; return e; }
    let is i64 as i with mut = 0;
    while (i < sc_len) { out[w] = sc_src[sc_off + i]; w = w + 1; i = i + 1; }
    out[w] = cast(u8, 58); w = w + 1;                                // ':'
    out[w] = cast(u8, 47); w = w + 1;                                // '/'
    out[w] = cast(u8, 47); w = w + 1;                                // '/'

    // --- authority ---
    //
    // A reference that brought its own is copied VERBATIM, as §5.2.2 assigns
    // R.authority: "http://h:80/p" resolves to itself, port and all. Dropping a
    // default port is normalisation (§6.2.3), which this does not do to input
    // the caller spelled out.
    //
    // A base's is rebuilt from its parts instead, because parts are all a Url
    // keeps. That forces one deviation: url_parse fills .port with the scheme
    // default when the URL omitted one, so "http://a" and "http://a:80" are
    // indistinguishable afterwards, and emitting the port would rewrite every
    // resolution against "http://a/b" as "http://a:80/...". The default is
    // therefore suppressed, and only a port the base actually differs on is
    // carried through.
    if (p.au_len >= 0) {
        if (w + p.au_len > max) { let is Url as e; e.ok = URL_ERR_SPACE; return e; }
        i = 0;
        while (i < p.au_len) { out[w] = ref[p.au_off + i]; w = w + 1; i = i + 1; }
    } else {
        let is i64 as need with mut = base.host_len;
        if (base.user_len > 0) { need = need + base.user_len + 1; }
        if (base.ip6 == 1) { need = need + 2; }
        if (w + need + 8 > max) { let is Url as e; e.ok = URL_ERR_SPACE; return e; }
        if (base.user_len > 0) {
            i = 0;
            while (i < base.user_len) { out[w] = base.src[base.user_off + i]; w = w + 1; i = i + 1; }
            out[w] = cast(u8, 64); w = w + 1;                        // '@'
        }
        if (base.ip6 == 1) { out[w] = cast(u8, 91); w = w + 1; }     // '['
        i = 0;
        while (i < base.host_len) { out[w] = base.src[base.host_off + i]; w = w + 1; i = i + 1; }
        if (base.ip6 == 1) { out[w] = cast(u8, 93); w = w + 1; }     // ']'
        // Carry the port only when it is not the scheme's default, so the
        // resolved URL compares equal to the one a caller would have typed.
        if (base.port != 0 && base.port != _url_default_port(base)) {
            out[w] = cast(u8, 58); w = w + 1;                        // ':'
            let is [8]u8 as digits;
            let is i64 as dn with mut = 0;
            let is i64 as pv with mut = base.port;
            while (pv > 0) { digits[dn] = cast(u8, 48 + (pv % 10)); dn = dn + 1; pv = pv / 10; }
            while (dn > 0) { dn = dn - 1; out[w] = digits[dn]; w = w + 1; }
        }
    }

    // --- path + query, per the §5.2.2 table ---
    let is i64 as path_start = w;
    let is i64 as take_base_query with mut = 0;

    if (p.sc_len >= 0 || p.au_len >= 0) {
        // Absolute or network-path: the reference's own path stands alone.
        if (w + p.pa_len > max) { let is Url as e; e.ok = URL_ERR_SPACE; return e; }
        i = 0;
        while (i < p.pa_len) { out[w] = ref[p.pa_off + i]; w = w + 1; i = i + 1; }
    } else if (p.pa_len == 0) {
        // No path: keep the base's, and its query too unless the reference
        // brought one. This is what makes "#frag" and "" resolve to the same
        // page rather than to the site root.
        if (w + base.path_len > max) { let is Url as e; e.ok = URL_ERR_SPACE; return e; }
        i = 0;
        while (i < base.path_len) { out[w] = base.src[base.path_off + i]; w = w + 1; i = i + 1; }
        if (p.qu_len < 0) { take_base_query = 1; }
    } else if (ref[p.pa_off] == 47) {
        // Absolute path: replaces the base's entirely.
        if (w + p.pa_len > max) { let is Url as e; e.ok = URL_ERR_SPACE; return e; }
        i = 0;
        while (i < p.pa_len) { out[w] = ref[p.pa_off + i]; w = w + 1; i = i + 1; }
    } else {
        // Relative path: merge onto the base's directory (§5.2.3) — everything
        // up to and including its last '/'. A base with no path at all behaves
        // as "/", which is why a bare "http://h" + "x" gives "/x".
        let is i64 as cut with mut = 0 - 1;
        i = 0;
        while (i < base.path_len) {
            if (base.src[base.path_off + i] == 47) { cut = i; }
            i = i + 1;
        }
        if (w + cut + 2 + p.pa_len > max) { let is Url as e; e.ok = URL_ERR_SPACE; return e; }
        if (cut < 0) {
            out[w] = cast(u8, 47); w = w + 1;
        } else {
            i = 0;
            while (i <= cut) { out[w] = base.src[base.path_off + i]; w = w + 1; i = i + 1; }
        }
        i = 0;
        while (i < p.pa_len) { out[w] = ref[p.pa_off + i]; w = w + 1; i = i + 1; }
    }

    // Normalise the path region alone — the authority above must not be touched.
    let is i64 as plen = _remove_dot_segments(cast(*u8, cast(i64, out) + path_start),
                                              w - path_start);
    w = path_start + plen;
    // An empty path under an authority becomes "/", per the scheme-based
    // normalisation of §6.2.3: "a URI that uses the generic syntax for
    // authority with an empty path should be normalized to a path of '/'".
    //
    // This is the one place the output differs from the literal §5.4.1 table,
    // which resolves "//g" to "http://g" with no path. The two are equivalent
    // by §6.2.3, and the normalised form is the one HTTP wants — a request
    // line needs a target, and every caller would otherwise have to add the
    // slash back. Anyone checking conformance against §5.4 alone will read
    // this as a mismatch, so it is deliberate and stated here and at the test.
    if (plen == 0) {
        if (w + 1 > max) { let is Url as e; e.ok = URL_ERR_SPACE; return e; }
        out[w] = cast(u8, 47); w = w + 1;
    }

    // --- query ---
    let is i64 as q_off with mut = 0 - 1;
    let is i64 as q_len with mut = 0;
    let is *u8 as q_src with mut = ref;
    if (take_base_query == 1) {
        if (base.query_len > 0) { q_src = base.src; q_off = base.query_off; q_len = base.query_len; }
    } else if (p.qu_len >= 0) {
        q_off = p.qu_off; q_len = p.qu_len;
    }
    if (q_off >= 0) {
        if (w + 1 + q_len > max) { let is Url as e; e.ok = URL_ERR_SPACE; return e; }
        out[w] = cast(u8, 63); w = w + 1;                            // '?'
        i = 0;
        while (i < q_len) { out[w] = q_src[q_off + i]; w = w + 1; i = i + 1; }
    }

    // --- fragment: always the reference's, present or not (§5.2.2) ---
    if (p.fr_len >= 0) {
        if (w + 1 + p.fr_len > max) { let is Url as e; e.ok = URL_ERR_SPACE; return e; }
        out[w] = cast(u8, 35); w = w + 1;                            // '#'
        i = 0;
        while (i < p.fr_len) { out[w] = ref[p.fr_off + i]; w = w + 1; i = i + 1; }
    }

    if (w + 1 > max) { let is Url as e; e.ok = URL_ERR_SPACE; return e; }
    out[w] = cast(u8, 0);
    return url_parse(out);
}

// Name of a URL_ERR_* code, for diagnostics.
fn url_err_name(e as i64) as *u8 {
    if (e == 0)              { return "URL_OK"; }
    if (e == URL_ERR_EMPTY)  { return "URL_ERR_EMPTY"; }
    if (e == URL_ERR_SCHEME) { return "URL_ERR_SCHEME"; }
    if (e == URL_ERR_HOST)   { return "URL_ERR_HOST"; }
    if (e == URL_ERR_PORT)   { return "URL_ERR_PORT"; }
    if (e == URL_ERR_SPACE)  { return "URL_ERR_SPACE"; }
    return "URL_ERR_UNKNOWN";
}
