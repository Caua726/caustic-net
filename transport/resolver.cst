// =======================================================
// caustic-net/transport/resolver.cst
// Turning a hostname into an address. The stub resolver.
//
// There is no libc here, so there is no getaddrinfo, and the standard library
// has no name resolution of any kind — `net.dial` takes a dotted quad and
// nothing else. Everything a browser does starts with a name, so this is the
// piece between `url_host()` and a socket.
//
// The order is the one every stub resolver uses, and each step exists because
// skipping it is wrong rather than merely slower:
//
//   1. A literal address parses as itself. "127.0.0.1" is not a name and
//      asking a server about it is both pointless and a privacy leak.
//   2. /etc/hosts, before the network. It is how a machine names itself and
//      how a developer redirects a domain; a resolver that goes to the wire
//      first quietly ignores both.
//   3. The cache, honouring the TTL the zone published — including for
//      failures, where the length comes from the SOA the server sent rather
//      than from a guess.
//   4. UDP to each configured server in turn, falling back to TCP when the
//      answer comes back truncated.
//
// Applied to each name in the SEARCH LIST, in the order `ndots` selects. On a
// network that sets one, a resolver that only ever asks the name as typed
// gives a wrong answer for `intranet` where every other program on the machine
// gives a right one — which is worse than being slow.
//
// proto/dns.cst does the wire format and owns every bound on it; this module
// does policy and I/O. The split is what lets the parser be tested against
// hostile packets without a socket.
//
// Reentrant: the query buffers are per call, and the two pieces of shared
// state — the answer cache and the parsed /etc/hosts — are behind one mutex.
// =======================================================

use "std/net.cst" as net;
use "std/io.cst" as io;
use "std/time.cst" as time;
use "std/sync.cst" as sync;
use "std/mem.cst" only bins, core as mem;
use "../core/conn.cst" as conn;
use "../core/errno.cst" as errno;
use "../core/entropy.cst" as entropy;
use "../proto/dns.cst" as dns;
use "./tcp_conn.cst" as tcpc;

// --- Errors. Shares the -1400 block with proto/dns; dns owns 1400..1409. ---
let is i64 as RES_ERR_CONFIG  with imut = 0 - 1420;   // no usable nameserver
let is i64 as RES_ERR_TIMEOUT with imut = 0 - 1421;   // every server, every try
let is i64 as RES_ERR_SOCKET  with imut = 0 - 1422;   // could not send at all
let is i64 as RES_ERR_SPACE   with imut = 0 - 1423;   // caller's buffer too small

let is i64 as MAX_SERVERS with imut = 3;
let is i64 as MAX_SEARCH  with imut = 6;
let is i64 as DNS_PORT    with imut = 53;

// A UDP answer is capped at 512 bytes without EDNS0, which is not advertised
// here — anything larger comes back with TC set and is refetched over TCP.
let is i64 as UDP_MAX with imut = 512;
let is i64 as TCP_MAX with imut = 8192;

let is i64 as DEFAULT_TIMEOUT_MS with imut = 2000;
let is i64 as DEFAULT_TRIES      with imut = 2;
let is i64 as DEFAULT_NDOTS      with imut = 1;

// TTL bounds. A zone that publishes 0 wants no caching at all and gets it; one
// that publishes a week gets a day, because this cache has no invalidation and
// a stale address outlives the reason anyone would look at it.
let is i64 as TTL_MIN with imut = 0;
let is i64 as TTL_MAX with imut = 86400;
// Only for a negative answer whose server sent no SOA to say otherwise. When
// there is one, dns_neg_ttl decides — see RFC 2308 §5.
let is i64 as TTL_NEG_FALLBACK with imut = 60;

struct Resolver {
    srv        as [3][16]u8;   // nameserver addresses, network order
    srv6       as [3]i64;      // 1 when the matching srv is IPv6
    nsrv       as i64;

    search     as [6][256]u8;  // suffixes from `search` / `domain`
    nsearch    as i64;
    ndots      as i64;

    timeout_ms as i64;
    tries      as i64;
    ready      as i64;
}

// --- Small helpers -----------------------------------------------------

fn _slen(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn _lower(c as u8) as u8 {
    if (c >= 65 && c <= 90) { return cast(u8, cast(i64, c) + 32); }
    return c;
}

fn _is_digit(c as u8) as i64 {
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}

fn _is_space(c as u8) as i64 {
    if (c == 32 || c == 9 || c == 13) { return 1; }
    return 0;
}

fn _starts(s as *u8, p as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (p[i] != 0) {
        if (s[i] == 0) { return 0; }
        if (s[i] != p[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn _num_after(s as *u8, off as i64) as i64 {
    let is i64 as v with mut = 0;
    let is i64 as i with mut = off;
    let is i64 as d with mut = 0;
    while (s[i] != 0 && _is_digit(s[i]) == 1) {
        v = v * 10 + (cast(i64, s[i]) - 48);
        d = d + 1;
        if (d > 6) { return 0 - 1; }
        i = i + 1;
    }
    if (d == 0) { return 0 - 1; }
    return v;
}

// Case-insensitive compare of two NUL-terminated names, ignoring one trailing
// dot on either side — "a.com" and "A.com." are the same name.
fn _name_eq(a as *u8, b as *u8) as i64 {
    let is i64 as la with mut = _slen(a);
    let is i64 as lb with mut = _slen(b);
    if (la > 1 && a[la - 1] == cast(u8, 46)) { la = la - 1; }
    if (lb > 1 && b[lb - 1] == cast(u8, 46)) { lb = lb - 1; }
    if (la != lb) { return 0; }
    let is i64 as i with mut = 0;
    while (i < la) {
        if (_lower(a[i]) != _lower(b[i])) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn _dots(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    let is i64 as i with mut = 0;
    while (s[i] != 0) {
        if (s[i] == cast(u8, 46)) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// Strict dotted quad. Returns 1 and writes four network-order bytes, or 0.
//
// Written here rather than using net.ip4_parse because that one reports
// failure as 0, which is also the value of "0.0.0.0" — and a resolver has to
// tell "this is already an address" from "this is a name" with no ambiguity at
// all, or it sends a DNS query for a literal.
fn parse_ipv4_bytes(s as *u8, out as *u8) as i64 {
    let is i64 as n = _slen(s);
    if (n < 7 || n > 15) { return 0; }
    let is i64 as octets with mut = 0;
    let is i64 as i with mut = 0;
    while (octets < 4) {
        let is i64 as digits with mut = 0;
        let is i64 as acc with mut = 0;
        while (i < n && _is_digit(s[i]) == 1) {
            acc = acc * 10 + (cast(i64, s[i]) - 48);
            digits = digits + 1;
            if (digits > 3) { return 0; }
            i = i + 1;
        }
        if (digits == 0) { return 0; }
        if (acc > 255) { return 0; }
        // A leading zero is how an octal quad sneaks past a naive parser and
        // resolves somewhere other than it reads.
        if (digits > 1 && s[i - digits] == cast(u8, 48)) { return 0; }
        out[octets] = cast(u8, acc);
        octets = octets + 1;
        if (octets < 4) {
            if (i >= n || s[i] != cast(u8, 46)) { return 0; }
            i = i + 1;
        }
    }
    if (i != n) { return 0; }
    return 1;
}

// The same, as a host-order integer — what net.addr_init wants.
fn parse_ipv4(s as *u8, out as *i64) as i64 {
    let is [4]u8 as b;
    if (parse_ipv4_bytes(s, cast(*u8, &b)) == 0) { return 0; }
    *out = (cast(i64, b[0]) << 24) + (cast(i64, b[1]) << 16)
         + (cast(i64, b[2]) << 8) + cast(i64, b[3]);
    return 1;
}

// Sixteen network-order bytes, or 0. net.ip6_parse answers 0 for success and
// nonzero for reject, which is the opposite of the convention here.
fn parse_ipv6(s as *u8, out as *u8) as i64 {
    if (net.ip6_parse(s, out) != 0) { return 0; }
    return 1;
}

// --- Shared state, and the one lock over it ----------------------------
//
// Everything below this line is process-wide: the parsed hosts file and the
// answer cache. A page pulls dozens of subresources, and `client/parallel`
// will fetch them on threads, so these are guarded rather than left to luck.
// The lock is only ever held across memory work — never across a socket — so
// one slow nameserver cannot block every other lookup.
let is sync.Mutex as _lk with mut;

let is [65536]u8 as _fbuf with mut;
let is i64 as _flen with mut = 0;

fn _read_conf(path as *u8) as i64 {
    _flen = 0;
    if (io.exists(path) == 0) { return 0 - 1; }
    let is i64 as sz = io.file_size(path);
    if (sz <= 0) { return 0 - 1; }
    // A truncated read would silently drop the entries past the cut, so a file
    // this large is refused rather than half-honoured.
    if (sz >= 65536) { return 0 - 1; }
    let is i64 as fd = io._open_read(path);
    if (fd < 0) { return 0 - 1; }
    let is i64 as got = io.read_exact(fd, cast(*u8, &_fbuf), sz);
    io._close_fd(fd);
    if (got != sz) { return 0 - 1; }
    _flen = sz;
    return 0;
}

// --- /etc/hosts --------------------------------------------------------
//
// Parsed once and kept, re-read when the file's mtime changes. It used to be
// re-read on every lookup, which put a file read in front of every cached
// answer — a page with fifty subresources paid for fifty of them.

struct HostEntry {
    name as [256]u8;
    addr as [16]u8;
    alen as i64;
}

let is [128]HostEntry as _hosts with mut;
let is i64 as _nhosts with mut = 0;
let is i64 as _hosts_mtime with mut = 0 - 1;
// Set when the file held more entries than the table. The lookup then scans
// the file directly instead, because dropping entries silently would answer a
// name the machine had been told about — the exact failure this file exists to
// prevent.
let is i64 as _hosts_overflow with mut = 0;

fn _host_add(name as *u8, nlen as i64, addr as *u8, alen as i64) as i64 {
    if (_nhosts >= 128) { _hosts_overflow = 1; return 0; }
    if (nlen >= 256) { return 1; }
    let is i64 as k with mut = 0;
    while (k < nlen) { _hosts[_nhosts].name[k] = name[k]; k = k + 1; }
    _hosts[_nhosts].name[nlen] = cast(u8, 0);
    k = 0;
    while (k < alen) { _hosts[_nhosts].addr[k] = addr[k]; k = k + 1; }
    _hosts[_nhosts].alen = alen;
    _nhosts = _nhosts + 1;
    return 1;
}

// Walk the loaded file, handing each (address, name) pair to `emit`-style
// inline handling. `want` is 4 or 16; a pair of the other family is skipped.
// `probe`, when non-null, is the name being looked for: found, it writes the
// address to `out` and returns 4/16 immediately.
fn _hosts_scan(want as i64, probe as *u8, out as *u8, into_table as i64) as i64 {
    let is [256]u8 as tok;
    let is [16]u8 as ab;
    let is i64 as pos with mut = 0;
    while (pos < _flen) {
        let is i64 as ls = pos;
        while (pos < _flen && _fbuf[pos] != 10) { pos = pos + 1; }
        let is i64 as le = pos;
        if (pos < _flen) { pos = pos + 1; }

        let is i64 as i with mut = ls;
        while (i < le && _fbuf[i] != 35) { i = i + 1; }        // '#'
        let is i64 as end = i;

        // first field: the address
        i = ls;
        while (i < end && _is_space(_fbuf[i]) == 1) { i = i + 1; }
        let is i64 as as_ = i;
        while (i < end && _is_space(_fbuf[i]) == 0) { i = i + 1; }
        let is i64 as alen_txt = i - as_;
        if (alen_txt == 0 || alen_txt > 255) { continue; }

        let is i64 as k with mut = 0;
        while (k < alen_txt) { tok[k] = _fbuf[as_ + k]; k = k + 1; }
        tok[alen_txt] = cast(u8, 0);

        let is i64 as alen with mut = 0;
        if (parse_ipv4_bytes(cast(*u8, &tok), cast(*u8, &ab)) == 1) { alen = 4; }
        else {
            if (parse_ipv6(cast(*u8, &tok), cast(*u8, &ab)) == 1) { alen = 16; }
            else { continue; }
        }

        // every remaining field is a name for it
        while (i < end) {
            while (i < end && _is_space(_fbuf[i]) == 1) { i = i + 1; }
            let is i64 as ns = i;
            while (i < end && _is_space(_fbuf[i]) == 0) { i = i + 1; }
            let is i64 as nlen = i - ns;
            if (nlen == 0 || nlen > 255) { continue; }
            let is i64 as j with mut = 0;
            while (j < nlen) { tok[j] = _fbuf[ns + j]; j = j + 1; }
            tok[nlen] = cast(u8, 0);

            if (into_table == 1) {
                _host_add(cast(*u8, &tok), nlen, cast(*u8, &ab), alen);
            } else {
                if (alen == want && _name_eq(cast(*u8, &tok), probe) == 1) {
                    let is i64 as c with mut = 0;
                    while (c < alen) { out[c] = ab[c]; c = c + 1; }
                    return alen;
                }
            }
        }
    }
    return 0;
}

// Reload the table if /etc/hosts changed. Caller holds the lock.
fn _hosts_refresh() as void {
    let is i64 as mt = io.mtime("/etc/hosts");
    if (mt == _hosts_mtime) { return; }
    _hosts_mtime = mt;
    _nhosts = 0;
    _hosts_overflow = 0;
    if (_read_conf("/etc/hosts") != 0) { return; }
    _hosts_scan(0, cast(*u8, 0), cast(*u8, 0), 1);
}

// Look `name` up in /etc/hosts. `want` is 4 for an A-style lookup and 16 for
// AAAA. Returns that many bytes in `out`, or 0 when the name is not there.
fn hosts_lookup_n(name as *u8, out as *u8, want as i64) as i64 {
    sync.mutex_lock(&_lk);
    _hosts_refresh();

    let is i64 as got with mut = 0;
    if (_hosts_overflow == 1) {
        // More entries than the table holds: answer from the file itself
        // rather than from a truncated copy of it.
        got = _hosts_scan(want, name, out, 0);
    } else {
        let is i64 as i with mut = 0;
        while (i < _nhosts) {
            if (_hosts[i].alen == want && _name_eq(cast(*u8, &_hosts[i].name), name) == 1) {
                let is i64 as k with mut = 0;
                while (k < want) { out[k] = _hosts[i].addr[k]; k = k + 1; }
                got = want;
                i = _nhosts;
            } else { i = i + 1; }
        }
    }
    sync.mutex_unlock(&_lk);
    return got;
}

// IPv4 only, the shape most callers want.
fn hosts_lookup(name as *u8, out as *u8) as i64 {
    return hosts_lookup_n(name, out, 4);
}

// --- /etc/resolv.conf --------------------------------------------------

fn resolver_defaults(r as *Resolver) as void {
    r.nsrv = 0;
    r.nsearch = 0;
    r.ndots = DEFAULT_NDOTS;
    r.timeout_ms = DEFAULT_TIMEOUT_MS;
    r.tries = DEFAULT_TRIES;
    r.ready = 1;
}

fn _add_server(r as *Resolver, tok as *u8) as void {
    if (r.nsrv >= MAX_SERVERS) { return; }
    let is [16]u8 as b;
    if (parse_ipv4_bytes(tok, cast(*u8, &b)) == 1) {
        let is i64 as k with mut = 0;
        while (k < 4) { r.srv[r.nsrv][k] = b[k]; k = k + 1; }
        r.srv6[r.nsrv] = 0;
        r.nsrv = r.nsrv + 1;
        return;
    }
    if (parse_ipv6(tok, cast(*u8, &b)) == 1) {
        let is i64 as k with mut = 0;
        while (k < 16) { r.srv[r.nsrv][k] = b[k]; k = k + 1; }
        r.srv6[r.nsrv] = 1;
        r.nsrv = r.nsrv + 1;
    }
}

fn _add_search(r as *Resolver, tok as *u8, tlen as i64) as void {
    if (r.nsearch >= MAX_SEARCH) { return; }
    if (tlen == 0 || tlen >= 256) { return; }
    // "search ." is the root, which is to say NO suffix — systemd-resolved
    // writes exactly that on a machine with no search domain. Appending it
    // would build "name.." and send a query for a name with an empty label in
    // the middle, which no zone can answer.
    if (tlen == 1 && tok[0] == cast(u8, 46)) { return; }
    let is i64 as k with mut = 0;
    while (k < tlen) { r.search[r.nsearch][k] = tok[k]; k = k + 1; }
    r.search[r.nsearch][tlen] = cast(u8, 0);
    r.nsearch = r.nsearch + 1;
}

fn _fallback_servers(r as *Resolver) as void {
    // A public resolver, stated rather than silent. There is no resolv.conf on
    // Windows and none is read from the registry yet, so this is that target's
    // normal path — and it means DNS leaves the machine to a third party. The
    // alternative is resolving nothing at all; a caller that minds can set
    // r.srv itself before the first lookup.
    r.srv[0][0] = cast(u8, 1); r.srv[0][1] = cast(u8, 1);
    r.srv[0][2] = cast(u8, 1); r.srv[0][3] = cast(u8, 1);
    r.srv6[0] = 0;
    r.srv[1][0] = cast(u8, 8); r.srv[1][1] = cast(u8, 8);
    r.srv[1][2] = cast(u8, 8); r.srv[1][3] = cast(u8, 8);
    r.srv6[1] = 0;
    r.nsrv = 2;
}

// Parse /etc/resolv.conf. Returns the nameserver count.
//
// `nameserver` (v4 and v6), `search`, `domain`, `options ndots:`, `timeout:`
// and `attempts:` are honoured. A machine that sets these usually has a reason
// — a slow link, a corporate suffix — and ignoring them makes this resolver
// answer differently from every other program on the box.
fn resolver_init(r as *Resolver) as i64 {
    resolver_defaults(r);

    sync.mutex_lock(&_lk);
    let is i64 as rc = _read_conf("/etc/resolv.conf");
    if (rc != 0) {
        sync.mutex_unlock(&_lk);
        _fallback_servers(r);
        return r.nsrv;
    }

    let is [256]u8 as tok;
    let is i64 as pos with mut = 0;
    while (pos < _flen) {
        let is i64 as ls = pos;
        while (pos < _flen && _fbuf[pos] != 10) { pos = pos + 1; }
        let is i64 as le = pos;
        if (pos < _flen) { pos = pos + 1; }

        let is i64 as i with mut = ls;
        while (i < le && _fbuf[i] != 35 && _fbuf[i] != 59) { i = i + 1; }   // '#' ';'
        let is i64 as end = i;

        i = ls;
        while (i < end && _is_space(_fbuf[i]) == 1) { i = i + 1; }
        let is i64 as ks = i;
        while (i < end && _is_space(_fbuf[i]) == 0) { i = i + 1; }
        let is i64 as klen = i - ks;
        if (klen == 0 || klen >= 256) { continue; }

        let is i64 as c with mut = 0;
        while (c < klen) { tok[c] = _fbuf[ks + c]; c = c + 1; }
        tok[klen] = cast(u8, 0);

        let is i64 as is_ns = _name_eq(cast(*u8, &tok), "nameserver");
        let is i64 as is_se = _name_eq(cast(*u8, &tok), "search");
        let is i64 as is_do = _name_eq(cast(*u8, &tok), "domain");
        let is i64 as is_op = _name_eq(cast(*u8, &tok), "options");
        if (is_ns == 0 && is_se == 0 && is_do == 0 && is_op == 0) { continue; }

        // `search` replaces any earlier list, as does `domain` — last one wins,
        // which is what every other resolver does with a repeated directive.
        if (is_se == 1 || is_do == 1) { r.nsearch = 0; }

        while (i < end) {
            while (i < end && _is_space(_fbuf[i]) == 1) { i = i + 1; }
            let is i64 as vs = i;
            while (i < end && _is_space(_fbuf[i]) == 0) { i = i + 1; }
            let is i64 as vlen = i - vs;
            if (vlen == 0 || vlen >= 256) { continue; }
            let is i64 as j with mut = 0;
            while (j < vlen) { tok[j] = _fbuf[vs + j]; j = j + 1; }
            tok[vlen] = cast(u8, 0);

            if (is_ns == 1) { _add_server(r, cast(*u8, &tok)); i = end; }
            if (is_do == 1) { _add_search(r, cast(*u8, &tok), vlen); i = end; }
            if (is_se == 1) { _add_search(r, cast(*u8, &tok), vlen); }
            if (is_op == 1) {
                if (_starts(cast(*u8, &tok), "ndots:") == 1) {
                    let is i64 as v = _num_after(cast(*u8, &tok), 6);
                    if (v >= 0 && v <= 15) { r.ndots = v; }
                }
                if (_starts(cast(*u8, &tok), "timeout:") == 1) {
                    let is i64 as v = _num_after(cast(*u8, &tok), 8);
                    if (v > 0 && v <= 30) { r.timeout_ms = v * 1000; }
                }
                if (_starts(cast(*u8, &tok), "attempts:") == 1) {
                    let is i64 as v = _num_after(cast(*u8, &tok), 9);
                    if (v > 0 && v <= 5) { r.tries = v; }
                }
            }
        }
    }
    sync.mutex_unlock(&_lk);

    if (r.nsrv == 0) { _fallback_servers(r); }
    return r.nsrv;
}

// --- Cache -------------------------------------------------------------

struct CacheEntry {
    name    as [256]u8;
    addr    as [16]u8;
    alen    as i64;      // 4, 16, or 0 for a remembered failure
    want    as i64;      // 4 or 16 — the question, not the answer
    expires as i64;      // epoch seconds; 0 = free
}

let is [64]CacheEntry as _cache with mut;
let is i64 as _cache_ready with mut = 0;

fn _cache_clear_locked() as void {
    let is i64 as i with mut = 0;
    while (i < 64) { _cache[i].expires = 0; i = i + 1; }
    _cache_ready = 1;
}

fn cache_clear() as void {
    sync.mutex_lock(&_lk);
    _cache_clear_locked();
    sync.mutex_unlock(&_lk);
}

fn _cache_find(name as *u8, want as i64, out as *u8) as i64 {
    sync.mutex_lock(&_lk);
    if (_cache_ready == 0) { _cache_clear_locked(); }
    let is i64 as now = time.unix_time();
    let is i64 as got with mut = 0;
    let is i64 as i with mut = 0;
    while (i < 64) {
        if (_cache[i].expires > now && _cache[i].want == want
            && _name_eq(cast(*u8, &_cache[i].name), name) == 1) {
            if (_cache[i].alen == 0) { got = dns.DNS_ERR_NXDOMAIN; }
            else {
                let is i64 as k with mut = 0;
                while (k < _cache[i].alen) { out[k] = _cache[i].addr[k]; k = k + 1; }
                got = _cache[i].alen;
            }
            i = 64;
        } else { i = i + 1; }
    }
    sync.mutex_unlock(&_lk);
    return got;
}

fn _cache_put(name as *u8, want as i64, addr as *u8, alen as i64, ttl as i64) as void {
    let is i64 as n = _slen(name);
    if (n >= 256) { return; }

    let is i64 as t with mut = ttl;
    if (t < TTL_MIN) { t = TTL_MIN; }
    if (t > TTL_MAX) { t = TTL_MAX; }
    if (t == 0) { return; }                    // the zone asked for no caching

    sync.mutex_lock(&_lk);
    if (_cache_ready == 0) { _cache_clear_locked(); }
    let is i64 as now = time.unix_time();

    // An entry for this same question is REPLACED, not duplicated. Without
    // this, re-resolving a live name leaves two entries for it and _cache_find
    // returns whichever it reaches first — as often the stale one as not, so a
    // refreshed answer would be ignored until the old copy aged out.
    let is i64 as pick with mut = 0 - 1;
    let is i64 as i with mut = 0;
    while (i < 64) {
        if (_cache[i].expires > 0 && _cache[i].want == want
            && _name_eq(cast(*u8, &_cache[i].name), name) == 1) { pick = i; i = 64; }
        else { i = i + 1; }
    }

    // Otherwise a free slot, else the one that expires soonest — the one whose
    // loss costs least.
    let is i64 as oldest with mut = 0;
    if (pick < 0) {
        i = 0;
        while (i < 64) {
            if (_cache[i].expires <= now) { pick = i; i = 64; }
            else {
                if (oldest == 0 || _cache[i].expires < oldest) { oldest = _cache[i].expires; }
                i = i + 1;
            }
        }
    }
    if (pick < 0) {
        i = 0;
        while (i < 64) {
            if (_cache[i].expires == oldest) { pick = i; i = 64; }
            else { i = i + 1; }
        }
    }
    if (pick < 0) { pick = 0; }

    let is i64 as k with mut = 0;
    while (k < n) { _cache[pick].name[k] = name[k]; k = k + 1; }
    _cache[pick].name[n] = cast(u8, 0);
    _cache[pick].alen = alen;
    _cache[pick].want = want;
    k = 0;
    while (k < alen) { _cache[pick].addr[k] = addr[k]; k = k + 1; }
    _cache[pick].expires = now + t;
    sync.mutex_unlock(&_lk);
}

// --- The query -------------------------------------------------------

// Is this datagram an answer to the question we asked? Three things have to
// agree — source address, query ID, and the echoed question — and all three
// are checked in the RECEIVE LOOP rather than by the caller.
//
// That placement is the point. A datagram that fails any of these is not this
// server failing; it is a stray, a late duplicate of an earlier query, or a
// forgery. Handing it up as "this server did not answer" would abandon the
// real reply still in flight and move on to the next server, which is a single
// junk packet turning into a failed lookup.
fn _from_matches(from as *u8, srv as *u8, is6 as i64) as i64 {
    let is i64 as n with mut = 4;
    let is i64 as off with mut = 4;      // sockaddr_in: addr at +4
    if (is6 == 1) { n = 16; off = 8; }   // sockaddr_in6: addr at +8
    let is i64 as k with mut = 0;
    while (k < n) {
        if (from[off + k] != srv[k]) { return 0; }
        k = k + 1;
    }
    return 1;
}

// Ask one server over UDP. Returns the reply length in `rx`, or <0.
// On return the reply is known to answer this exact question.
fn _query_udp(srv as *u8, is6 as i64, q as *u8, qlen as i64, rx as *u8,
              timeout_ms as i64, id as i64, name as *u8, qtype as i64) as i64 {
    let is [28]u8 as sa;
    let is [28]u8 as from;
    let is i64 as fd with mut = 0 - 1;
    let is i64 as sent with mut = 0 - 1;

    if (is6 == 1) {
        fd = net.udp_socket6();
        if (fd < 0) { return RES_ERR_SOCKET; }
        let is net.Addr6 as a = net.addr6_init(cast(*u8, &sa), srv, DNS_PORT);
        sent = net.udp_send6(fd, q, qlen, a);
    } else {
        fd = net.udp_socket();
        if (fd < 0) { return RES_ERR_SOCKET; }
        let is i64 as ip = (cast(i64, srv[0]) << 24) + (cast(i64, srv[1]) << 16)
                         + (cast(i64, srv[2]) << 8) + cast(i64, srv[3]);
        let is net.Addr as a = net.addr_init(cast(*u8, &sa), ip, DNS_PORT);
        sent = net.udp_send(fd, q, qlen, a);
    }
    if (sent < 0) { net.close(fd); return RES_ERR_SOCKET; }

    // A deadline, not a single wait: a datagram from somewhere else resets the
    // wait but must not extend the total, or an attacker holds the resolver
    // open by dribbling packets at it.
    let is i64 as deadline = conn.deadline_in(timeout_ms);
    while (1 == 1) {
        let is i64 as left = conn.deadline_remaining(deadline);
        if (left <= 0) { net.close(fd); return RES_ERR_TIMEOUT; }
        if (net.wait_readable(fd, left) <= 0) { net.close(fd); return RES_ERR_TIMEOUT; }

        let is i64 as n with mut = 0;
        if (is6 == 1) { n = net.udp_recv6(fd, rx, UDP_MAX, cast(*u8, &from)); }
        else { n = net.udp_recv(fd, rx, UDP_MAX, cast(*u8, &from)); }
        if (n <= 0) { continue; }

        if (_from_matches(cast(*u8, &from), srv, is6) == 0) { continue; }

        let is dns.DnsMsg as m;
        if (dns.dns_parse(rx, n, &m) != 0) { continue; }
        if (m.id != id) { continue; }
        if (dns.dns_check_question(&m, name, qtype) != 1) { continue; }

        net.close(fd);
        return n;
    }
    net.close(fd);
    return RES_ERR_TIMEOUT;
}

// The same question over TCP, for when UDP came back truncated. DNS over TCP
// prefixes the message with a 2-byte big-endian length, in both directions.
//
// Validated the same way UDP is, even though a TCP reply arrives on a socket
// only this server can write to: the checks are cheap, and "it came over TCP"
// is not a reason to trust a message with the wrong ID in it.
fn _query_tcp(srv as *u8, is6 as i64, q as *u8, qlen as i64, rx as *u8,
              timeout_ms as i64, id as i64, name as *u8, qtype as i64) as i64 {
    let is [28]u8 as sa;
    let is i64 as fd with mut = 0 - 1;
    if (is6 == 1) {
        let is net.Addr6 as a = net.addr6_init(cast(*u8, &sa), srv, DNS_PORT);
        fd = net.tcp_connect6(a);
    } else {
        let is i64 as ip = (cast(i64, srv[0]) << 24) + (cast(i64, srv[1]) << 16)
                         + (cast(i64, srv[2]) << 8) + cast(i64, srv[3]);
        let is net.Addr as a = net.addr_init(cast(*u8, &sa), ip, DNS_PORT);
        fd = net.tcp_connect(a);
    }
    if (fd < 0) { return RES_ERR_SOCKET; }
    let is *conn.Conn as c = tcpc.conn_from_fd(fd);
    if (cast(i64, c) == 0) { net.close(fd); return RES_ERR_SOCKET; }

    let is i64 as deadline = conn.deadline_in(timeout_ms);

    let is [2]u8 as pfx;
    pfx[0] = cast(u8, (qlen >> 8) & 255);
    pfx[1] = cast(u8, qlen & 255);
    if (conn.conn_write_all_by(c, cast(*u8, &pfx), 2, deadline) != 2) {
        conn.conn_free(c); return RES_ERR_SOCKET;
    }
    if (conn.conn_write_all_by(c, q, qlen, deadline) != qlen) {
        conn.conn_free(c); return RES_ERR_SOCKET;
    }
    if (conn.conn_read_exact_by(c, cast(*u8, &pfx), 2, deadline) != 2) {
        conn.conn_free(c); return RES_ERR_TIMEOUT;
    }
    let is i64 as rlen = (cast(i64, pfx[0]) << 8) + cast(i64, pfx[1]);
    if (rlen <= 0 || rlen > TCP_MAX) { conn.conn_free(c); return dns.DNS_ERR_FORMAT; }
    if (conn.conn_read_exact_by(c, rx, rlen, deadline) != rlen) {
        conn.conn_free(c); return RES_ERR_TIMEOUT;
    }
    conn.conn_free(c);

    let is dns.DnsMsg as m;
    if (dns.dns_parse(rx, rlen, &m) != 0) { return dns.DNS_ERR_FORMAT; }
    if (m.id != id) { return dns.DNS_ERR_MISMATCH; }
    if (dns.dns_check_question(&m, name, qtype) != 1) { return dns.DNS_ERR_MISMATCH; }
    return rlen;
}

// One question, asked of every server in turn, retried `tries` times.
// Returns the address length written to `out`, or <0.
fn _ask(r as *Resolver, name as *u8, want as i64, out as *u8, ttl_out as *i64) as i64 {
    let is i64 as qtype with mut = dns.T_A;
    if (want == 16) { qtype = dns.T_AAAA; }

    // Per call, so two threads resolving at once do not share a buffer.
    let is [8192]u8 as rx;
    let is [768]u8 as tx;

    let is i64 as last with mut = RES_ERR_TIMEOUT;
    let is i64 as attempt with mut = 0;
    while (attempt < r.tries) {
        let is i64 as si with mut = 0;
        while (si < r.nsrv) {
            // A fresh ID per attempt. Reusing one across retries hands an
            // off-path attacker a second guess at the same target.
            let is i64 as id with mut = 0;
            if (dns.dns_new_id(&id) < 0) { return RES_ERR_SOCKET; }

            let is i64 as qlen = dns.dns_encode_query(name, qtype, id, cast(*u8, &tx), 768);
            if (qlen < 0) { return qlen; }

            let is i64 as n with mut = _query_udp(cast(*u8, &r.srv[si]), r.srv6[si],
                                                  cast(*u8, &tx), qlen, cast(*u8, &rx),
                                                  r.timeout_ms, id, name, qtype);
            if (n > 0) {
                let is dns.DnsMsg as m;
                if (dns.dns_parse(cast(*u8, &rx), n, &m) != 0) { n = dns.DNS_ERR_FORMAT; }
                else {
                    if (m.tc == 1) {
                        n = _query_tcp(cast(*u8, &r.srv[si]), r.srv6[si],
                                       cast(*u8, &tx), qlen, cast(*u8, &rx),
                                       r.timeout_ms, id, name, qtype);
                        if (n > 0) {
                            if (dns.dns_parse(cast(*u8, &rx), n, &m) != 0) { n = dns.DNS_ERR_FORMAT; }
                        }
                    }
                }

                if (n > 0) {
                    let is i64 as ttl with mut = 0;
                    let is i64 as want6 with mut = 0;
                    if (want == 16) { want6 = 1; }
                    let is i64 as got = dns.dns_addr_of(&m, name, out, want6, &ttl);
                    if (got > 0) { *ttl_out = ttl; return got; }

                    // NXDOMAIN and NODATA are ANSWERS, not failures to reach a
                    // server: every other server will say the same thing, so
                    // stop here rather than asking them all. How long the
                    // absence may be remembered comes from the SOA the server
                    // sent with it, per RFC 2308 §5 — a fixed number here would
                    // either re-ask a dead name constantly or keep believing in
                    // its absence after it starts existing.
                    if (got == dns.DNS_ERR_NXDOMAIN || got == dns.DNS_ERR_NODATA) {
                        let is i64 as neg with mut = dns.dns_neg_ttl(&m);
                        if (neg < 0) { neg = TTL_NEG_FALLBACK; }
                        *ttl_out = neg;
                        return got;
                    }
                    n = got;
                }
            }
            // Anything left is this server failing to answer usefully; record
            // it and try the next one. Unconditional, so a malformed reply
            // cannot leave `last` reporting some earlier server's problem.
            last = n;
            si = si + 1;
        }
        attempt = attempt + 1;
    }
    return last;
}

// --- The API -----------------------------------------------------------

// One candidate name, all the way through: hosts, cache, wire.
fn _try_name(r as *Resolver, fqdn as *u8, want as i64, out as *u8) as i64 {
    let is i64 as h = hosts_lookup_n(fqdn, out, want);
    if (h == want) { return want; }

    let is i64 as c = _cache_find(fqdn, want, out);
    if (c > 0) { return c; }
    if (c == dns.DNS_ERR_NXDOMAIN) { return c; }

    let is i64 as ttl with mut = 0;
    let is i64 as got = _ask(r, fqdn, want, out, &ttl);
    if (got > 0) {
        _cache_put(fqdn, want, out, got, ttl);
        return got;
    }
    // Remember a definitive "no" so a typo does not re-ask every server on
    // every retry. A timeout is NOT definitive and is not cached.
    if (got == dns.DNS_ERR_NXDOMAIN || got == dns.DNS_ERR_NODATA) {
        _cache_put(fqdn, want, out, 0, ttl);
    }
    return got;
}

// Join `name` and `suffix` into `out` (256 bytes). 0 on success.
fn _join(name as *u8, suffix as *u8, out as *u8) as i64 {
    let is i64 as a = _slen(name);
    let is i64 as b = _slen(suffix);
    if (a + 1 + b >= 256) { return 0 - 1; }
    let is i64 as k with mut = 0;
    while (k < a) { out[k] = name[k]; k = k + 1; }
    out[k] = cast(u8, 46); k = k + 1;
    let is i64 as j with mut = 0;
    while (j < b) { out[k + j] = suffix[j]; j = j + 1; }
    out[k + b] = cast(u8, 0);
    return 0;
}

// Resolve `name`, writing 4 bytes (A) or 16 (AAAA) to `out` and returning that
// count, or <0. `out` must have room for 16.
//
// Consults, in order: a literal address, then for each candidate produced by
// the search list — /etc/hosts, the cache, the network.
fn resolve(r as *Resolver, name as *u8, out as *u8, want6 as i64) as i64 {
    if (r.ready == 0) { resolver_init(r); }
    if (r.nsrv == 0) { return RES_ERR_CONFIG; }

    let is i64 as want with mut = 4;
    if (want6 == 1) { want = 16; }

    let is i64 as n = _slen(name);
    if (n == 0 || n > 255) { return dns.DNS_ERR_NAME; }

    // A literal is already an answer.
    let is [16]u8 as lit;
    if (parse_ipv4_bytes(name, cast(*u8, &lit)) == 1) {
        if (want == 16) { return dns.DNS_ERR_NODATA; }
        let is i64 as k with mut = 0;
        while (k < 4) { out[k] = lit[k]; k = k + 1; }
        return 4;
    }
    if (parse_ipv6(name, cast(*u8, &lit)) == 1) {
        if (want == 4) { return dns.DNS_ERR_NODATA; }
        let is i64 as k with mut = 0;
        while (k < 16) { out[k] = lit[k]; k = k + 1; }
        return 16;
    }

    // A trailing dot means the name is absolute: no suffix is appended, ever.
    if (name[n - 1] == cast(u8, 46)) { return _try_name(r, name, want, out); }

    // With no search list there is nothing to decide.
    if (r.nsearch == 0) { return _try_name(r, name, want, out); }

    // ndots: a name with at least that many dots is tried AS TYPED first, and
    // only then through the suffixes; below the threshold the suffixes come
    // first. That ordering is what makes `intranet` find the corporate host
    // while `example.com` still reaches the internet one rather than a
    // same-named machine inside the network.
    let is [256]u8 as cand;
    let is i64 as absolute_first with mut = 0;
    if (_dots(name) >= r.ndots) { absolute_first = 1; }

    // Two results are tracked, because they answer different questions.
    //
    // `abs_r` is what the name AS TYPED produced. It is the name the caller
    // asked about, so if it came back NXDOMAIN that is a real answer and no
    // amount of trouble reaching a server about `name.some.suffix` should
    // replace it — a suffix failing tells you nothing about the name itself.
    //
    // `last` is the best a suffix managed, and only stands in when the
    // absolute name was never asked or never answered.
    let is i64 as abs_r with mut = 0;
    let is i64 as last with mut = dns.DNS_ERR_NXDOMAIN;

    if (absolute_first == 1) {
        let is i64 as g = _try_name(r, name, want, out);
        if (g > 0) { return g; }
        abs_r = g;
    }

    let is i64 as i with mut = 0;
    while (i < r.nsearch) {
        if (_join(name, cast(*u8, &r.search[i]), cast(*u8, &cand)) == 0) {
            let is i64 as g = _try_name(r, cast(*u8, &cand), want, out);
            if (g > 0) { return g; }
            // A hard failure to reach anyone is worth reporting over a
            // "no such name" from a suffix that was never going to exist.
            if (g != dns.DNS_ERR_NXDOMAIN && g != dns.DNS_ERR_NODATA) { last = g; }
        }
        i = i + 1;
    }

    if (absolute_first == 0) {
        let is i64 as g = _try_name(r, name, want, out);
        if (g > 0) { return g; }
        abs_r = g;
    }

    if (abs_r != 0) { return abs_r; }
    return last;
}

// Format a resolved address as text. `out` needs 16 bytes for IPv4, 46 for
// IPv6. Returns the length written, or <0.
fn addr_str(addr as *u8, alen as i64, out as *u8, max as i64) as i64 {
    if (alen == 4) {
        if (max < 16) { return RES_ERR_SPACE; }
        let is i64 as ip = (cast(i64, addr[0]) << 24) + (cast(i64, addr[1]) << 16)
                         + (cast(i64, addr[2]) << 8) + cast(i64, addr[3]);
        return net.ip4_format(ip, out);
    }
    if (alen == 16) {
        if (max < 46) { return RES_ERR_SPACE; }
        return net.ip6_format(addr, out);
    }
    return RES_ERR_SPACE;
}

fn res_err_name(e as i64) as *u8 {
    if (e == RES_ERR_CONFIG)  { return "RES_ERR_CONFIG"; }
    if (e == RES_ERR_TIMEOUT) { return "RES_ERR_TIMEOUT"; }
    if (e == RES_ERR_SOCKET)  { return "RES_ERR_SOCKET"; }
    if (e == RES_ERR_SPACE)   { return "RES_ERR_SPACE"; }
    return dns.dns_err_name(e);
}
