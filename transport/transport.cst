// =======================================================
// caustic-net/transport/transport.cst
// Connection/listener primitives that return *Conn. Thin layer
// over std/net.cst that hands callers the polymorphic Conn so
// they never see fds. Socket tuning passes through to net.
// =======================================================

use "std/net.cst" as net;
use "std/mem.cst" only bins, core as mem;
use "./tcp_conn.cst" as tcpc;
use "./resolver.cst" as res;
use "../core/conn.cst" as conn;
use "../core/errno.cst" as errno;
use "../proto/dns.cst" as dns;

// One-time WSAStartup on Windows; no-op on Linux. Safe to call repeatedly.
fn init() as i32 {
    return net.init();
}

// --- connect ---

// Blocking connect to "a.b.c.d":port. Returns *Conn, or null on failure.
fn dial(ip_str as *u8, port as i64) as *conn.Conn {
    let is i64 as fd = net.dial(ip_str, port);
    if (fd < 0) { return cast(*conn.Conn, 0); }
    return tcpc.conn_from_fd(fd);
}

// One resolver for the process. A Resolver is configuration and a cache, not a
// connection, so sharing it is what makes the cache worth having — and it is
// what `dial_host` uses when the caller has not brought their own.
let is res.Resolver as _res with mut;

fn resolver() as *res.Resolver {
    if (_res.ready == 0) { res.resolver_init(&_res); }
    return &_res;
}

// Blocking connect to a HOST NAME and port — the call everything above the
// transport actually wants, since a URL carries a name and `dial` takes a
// dotted quad. Resolves through /etc/hosts, the cache and DNS, then connects.
//
// Returns *Conn, or null. The reason is available from `dial_host_err()`:
// telling "the name does not exist" from "the host refused the connection"
// is the difference between two error pages, and squeezing both into a null
// pointer would throw that away.
let is i64 as _dial_err with mut = 0;

fn dial_host_err() as i64 { return _dial_err; }

fn _connect_addr(addr as *u8, alen as i64, port as i64) as *conn.Conn {
    if (alen == 4) {
        let is i64 as ip = (cast(i64, addr[0]) << 24) + (cast(i64, addr[1]) << 16)
                         + (cast(i64, addr[2]) << 8) + cast(i64, addr[3]);
        return connect_ip4(ip, port);
    }
    if (alen == 16) {
        let is [28]u8 as buf6;
        let is net.Addr6 as a6 = net.addr6_init(cast(*u8, &buf6), addr, port);
        let is i64 as fd = net.tcp_connect6(a6);
        if (fd < 0) { return cast(*conn.Conn, 0); }
        return tcpc.conn_from_fd(fd);
    }
    return cast(*conn.Conn, 0);
}

fn dial_host(host as *u8, port as i64) as *conn.Conn {
    _dial_err = 0;
    let is [16]u8 as addr;
    let is *res.Resolver as r = resolver();

    // A first, then AAAA. Not the RFC 6724 preference, and deliberately not:
    // without Happy Eyeballs (RFC 8305) there is no concurrent attempt to fall
    // back FROM, so trying IPv6 first on a v4-only network costs a full
    // connect timeout on every request. A serial resolver should lead with the
    // family that works everywhere. When client/parallel lands, the two become
    // simultaneous and this ordering stops mattering.
    let is i64 as n with mut = res.resolve(r, host, cast(*u8, &addr), 0);
    if (n > 0) {
        let is *conn.Conn as k = _connect_addr(cast(*u8, &addr), n, port);
        if (cast(i64, k) != 0) { return k; }
        // The name resolves and the host will not take the connection. Trying
        // AAAA next is still worth it: a dual-stack host can be reachable on
        // one family and not the other.
        _dial_err = 0 - errno.ECONNREFUSED;
    } else {
        _dial_err = n;
    }

    let is i64 as n6 = res.resolve(r, host, cast(*u8, &addr), 1);
    if (n6 > 0) {
        let is *conn.Conn as k6 = _connect_addr(cast(*u8, &addr), n6, port);
        if (cast(i64, k6) != 0) { _dial_err = 0; return k6; }
        _dial_err = 0 - errno.ECONNREFUSED;
        return cast(*conn.Conn, 0);
    }

    // Neither family. Report whichever failure says more: "no such name" beats
    // "this name has no address of that kind", since the second is expected
    // for a v4-only host and tells the caller nothing.
    if (n < 0 && n6 == dns.DNS_ERR_NODATA) { _dial_err = n; }
    else {
        if (n6 < 0 && n == dns.DNS_ERR_NODATA) { _dial_err = n6; }
    }
    return cast(*conn.Conn, 0);
}

// Blocking connect to a host-byte-order IPv4 + port. Returns *Conn or null.
fn connect_ip4(ip as i64, port as i64) as *conn.Conn {
    let is [16]u8 as buf;
    let is net.Addr as a = net.addr_init(cast(*u8, &buf), ip, port);
    let is i64 as fd = net.tcp_connect(a);
    if (fd < 0) { return cast(*conn.Conn, 0); }
    return tcpc.conn_from_fd(fd);
}

// --- listen / accept ---

// A bound, listening socket. A struct rather than a bare fd so that closing a
// listener goes through this module like everything else — callers above the
// transport never handle a descriptor.
struct Listener {
    fd as i64;
}

// Bind+listen on a host-byte-order IPv4 + port.
// `ok` is 0 on success; on failure it carries the negative -errno from bind or
// listen, and `fd` is that same value.
struct ListenResult {
    l  as Listener;
    ok as i64;
}

fn listen(ip as i64, port as i64) as ListenResult {
    let is [16]u8 as buf;
    let is net.Addr as a = net.addr_init(cast(*u8, &buf), ip, port);
    let is i64 as fd = net.tcp_listen(a);
    let is ListenResult as r;
    r.l.fd = fd;
    r.ok = 0;
    if (fd < 0) { r.ok = fd; }
    return r;
}

// Listen on 0.0.0.0:port.
fn listen_any(port as i64) as ListenResult {
    return listen(net.INADDR_ANY, port);
}

// Listen on 127.0.0.1:port — a service that must not leave the machine.
fn listen_loopback(port as i64) as ListenResult {
    return listen(net.INADDR_LOOPBACK, port);
}

// Accept one connection, returning it as a *Conn (or null on error). The
// peer's address is captured into the Conn, so a server can log or ACL on it
// (tcpc.conn_peer_ip / conn_peer_port).
fn accept_conn(l as *Listener) as *conn.Conn {
    let is [16]u8 as peer;
    mem.core.memset(cast(*u8, &peer), cast(i32, 0), 16);
    let is i64 as fd = net.tcp_accept(l.fd, cast(*u8, &peer));
    if (fd < 0) { return cast(*conn.Conn, 0); }
    return tcpc.conn_from_fd_peer(fd, cast(*u8, &peer));
}

// Stop accepting and release the socket. Idempotent.
fn listener_close(l as *Listener) as void {
    if (l.fd < 0) { return; }
    net.close(l.fd);
    l.fd = 0 - 1;
}

// The raw fd behind a Listener (to register it with a poller).
fn listener_fd(l as *Listener) as i64 {
    return l.fd;
}

// Wait until a Listener has a connection ready (poll, ms timeout).
fn listener_wait(l as *Listener, timeout_ms as i64) as i64 {
    return net.wait_readable(l.fd, timeout_ms);
}

// --- socket tuning (pass-throughs; operate on the fd behind a Conn) ---

fn set_nodelay(k as *conn.Conn) as i64   { return net.set_nodelay(tcpc.conn_fd(k)); }
fn set_keepalive(k as *conn.Conn) as i64 { return net.set_keepalive(tcpc.conn_fd(k)); }
fn set_nonblock(k as *conn.Conn) as i64  { return net.set_nonblock(tcpc.conn_fd(k)); }
fn set_recv_timeout(k as *conn.Conn, secs as i64) as i64 { return net.set_recv_timeout(tcpc.conn_fd(k), secs); }
fn set_send_timeout(k as *conn.Conn, secs as i64) as i64 { return net.set_send_timeout(tcpc.conn_fd(k), secs); }

// Wait for readability/writability on the fd behind a Conn (poll, ms timeout).
fn wait_readable(k as *conn.Conn, timeout_ms as i64) as i64 { return net.wait_readable(tcpc.conn_fd(k), timeout_ms); }
fn wait_writable(k as *conn.Conn, timeout_ms as i64) as i64 { return net.wait_writable(tcpc.conn_fd(k), timeout_ms); }
