// =======================================================
// caustic-net/core/bufread.cst
// BufReader — buffered, line-aware reading over a *Conn.
//
// HTTP/1.1 and WebSocket are framed by delimiters (CRLF, then a
// length), not by read boundaries, so nothing above the transport
// can work with raw conn_read: a header line arrives split across
// two packets, and two header lines arrive in one. This is the
// layer that turns a byte stream into lines and exact counts.
//
// It sits on *Conn, not on an fd, so it reads through TLS the same
// way it reads through plain TCP — that is the whole point of the
// vtable.
//
// The buffer is also the header-size limit: a line longer than the
// buffer is refused rather than grown, which is what keeps a peer
// from making a server allocate without bound.
// =======================================================

use "std/mem.cst" only bins, core as mem;
use "../core/conn.cst" as conn;
use "../core/errno.cst" as errno;

// Sentinels, in the same range as errno.cst's WANT_READ/WANT_WRITE so they can
// never be confused with a -errno.
let is i64 as BR_EOF      with imut = 0 - 1100;   // stream ended, nothing left
let is i64 as BR_TOO_LONG with imut = 0 - 1101;   // line longer than the buffer

let is i64 as DEFAULT_CAP with imut = 8192;

struct BufReader {
    c    as *conn.Conn;   // the stream underneath (TCP today, TLS later)
    buf  as *u8;
    cap  as i64;
    head as i64;          // next unread byte
    tail as i64;          // one past the last buffered byte
    eof  as i64;          // 1 once the peer closed
    err  as i64;          // sticky -errno, 0 while healthy
}

// Buffered bytes waiting to be consumed.
fn br_buffered(br as *BufReader) as i64 {
    return br.tail - br.head;
}

fn br_eof(br as *BufReader) as i64 { return br.eof; }
fn br_err(br as *BufReader) as i64 { return br.err; }

// Initialise a BufReader over `c` using caller-provided storage — no
// allocation, so a server can keep one per connection in its own arena.
// `cap` is the largest line this reader will ever accept.
fn br_init(br as *BufReader, c as *conn.Conn, buf as *u8, cap as i64) as void {
    br.c    = c;
    br.buf  = buf;
    br.cap  = cap;
    br.head = 0;
    br.tail = 0;
    br.eof  = 0;
    br.err  = 0;
}

// Move the unread bytes to the front, so a fill has the whole tail to work
// with. Cheap: the unread region is at most one partial line.
fn _br_compact(br as *BufReader) as void {
    if (br.head == 0) { return; }
    let is i64 as n = br.tail - br.head;
    if (n > 0) { mem.core.memmove(br.buf, cast(*u8, cast(i64, br.buf) + br.head), n); }
    br.head = 0;
    br.tail = n;
}

// One read from the stream into free buffer space.
// Returns bytes added (>0), 0 at EOF, or <0 -errno. Retries EINTR.
fn br_fill(br as *BufReader) as i64 {
    if (br.err != 0) { return br.err; }
    _br_compact(br);
    if (br.tail >= br.cap) { return 0; }            // full: caller must consume first
    while (1 == 1) {
        let is i64 as n = conn.conn_read(br.c,
                                         cast(*u8, cast(i64, br.buf) + br.tail),
                                         br.cap - br.tail);
        if (n == 0 - errno.EINTR) { continue; }
        if (n > 0) { br.tail = br.tail + n; return n; }
        if (n == 0) { br.eof = 1; return 0; }
        br.err = n;
        return n;
    }
    return 0;
}

// Copy up to `n` bytes into `out`. Returns bytes copied, 0 at EOF, <0 -errno.
// Short reads are normal — this is a stream, not a record.
fn br_read(br as *BufReader, out as *u8, n as i64) as i64 {
    if (n <= 0) { return 0; }
    if (br_buffered(br) == 0) {
        let is i64 as f = br_fill(br);
        if (f < 0) { return f; }
        if (f == 0) { return 0; }
    }
    let is i64 as have = br_buffered(br);
    let is i64 as k with mut = n;
    if (k > have) { k = have; }
    mem.core.memcpy(out, cast(*u8, cast(i64, br.buf) + br.head), k);
    br.head = br.head + k;
    if (br.head == br.tail) { br.head = 0; br.tail = 0; }
    return k;
}

// Fill `out` with exactly `n` bytes. Returns n, or the short count at EOF, or
// <0 -errno. This is how a body of known Content-Length is drained.
fn br_read_exact(br as *BufReader, out as *u8, n as i64) as i64 {
    let is i64 as got with mut = 0;
    while (got < n) {
        let is i64 as k = br_read(br, cast(*u8, cast(i64, out) + got), n - got);
        if (k < 0) { return k; }
        if (k == 0) { return got; }
        got = got + k;
    }
    return got;
}

// The next byte (0..255), or BR_EOF, or <0 -errno.
fn br_byte(br as *BufReader) as i64 {
    let is [1]u8 as b;
    let is i64 as k = br_read(br, cast(*u8, &b), 1);
    if (k < 0) { return k; }
    if (k == 0) { return BR_EOF; }
    return cast(i64, b[0]);
}

// Throw away `n` bytes without copying them (an unwanted body).
// Returns bytes discarded, which is short at EOF, or <0 -errno.
fn br_discard(br as *BufReader, n as i64) as i64 {
    let is i64 as gone with mut = 0;
    while (gone < n) {
        if (br_buffered(br) == 0) {
            let is i64 as f = br_fill(br);
            if (f < 0) { return f; }
            if (f == 0) { return gone; }
        }
        let is i64 as have = br_buffered(br);
        let is i64 as k with mut = n - gone;
        if (k > have) { k = have; }
        br.head = br.head + k;
        if (br.head == br.tail) { br.head = 0; br.tail = 0; }
        gone = gone + k;
    }
    return gone;
}

// Look at the next `n` buffered bytes without consuming them, filling as
// needed. Returns how many are actually visible (may be < n at EOF, and is
// capped by the buffer). Used to sniff a delimiter before committing.
fn br_peek(br as *BufReader, out as *u8, n as i64) as i64 {
    let is i64 as want with mut = n;
    if (want > br.cap) { want = br.cap; }
    while (br_buffered(br) < want) {
        let is i64 as f = br_fill(br);
        if (f < 0) { return f; }
        if (f == 0) { break; }
    }
    let is i64 as have with mut = br_buffered(br);
    if (have > want) { have = want; }
    if (have > 0) { mem.core.memcpy(out, cast(*u8, cast(i64, br.buf) + br.head), have); }
    return have;
}

// Index of the first `\n` in the buffered region, or -1.
fn _br_find_nl(br as *BufReader) as i64 {
    let is i64 as i with mut = br.head;
    while (i < br.tail) {
        if (br.buf[i] == 10) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// Read one CRLF- or LF-terminated line into `out`, without the terminator.
// The line IS NUL-terminated, so `max` must leave room for that byte — a line
// of exactly `max` characters does not fit. Returns the line length (0 for a
// bare CRLF, which is how the end of an HTTP header block announces itself), or:
//   BR_EOF       stream ended with no bytes at all
//   BR_TOO_LONG  no terminator within `max` or within the buffer
//   <0 -errno    transport error
//
// The NUL is not free, but the alternative is worse: every caller that treats
// the result as a string has to remember to add one, and the buffer it forgot
// to terminate is stack garbage that reads as a plausible header.
//
// A final line that ends at EOF instead of a newline is returned as a line;
// br_eof() distinguishes it from a properly terminated one.
fn br_read_line(br as *BufReader, out as *u8, max as i64) as i64 {
    while (1 == 1) {
        let is i64 as nl = _br_find_nl(br);
        if (nl >= 0) {
            let is i64 as raw = nl - br.head;              // bytes before the \n
            let is i64 as n with mut = raw;
            if (n > 0 && br.buf[br.head + n - 1] == 13) { n = n - 1; }   // strip \r
            if (n + 1 > max) { return BR_TOO_LONG; }
            if (n > 0) { mem.core.memcpy(out, cast(*u8, cast(i64, br.buf) + br.head), n); }
            out[n] = cast(u8, 0);
            br.head = nl + 1;                             // consume the \n too
            if (br.head == br.tail) { br.head = 0; br.tail = 0; }
            return n;
        }

        // No terminator yet. If the buffer is full, this line is longer than
        // the reader is willing to hold — refuse instead of growing.
        if (br_buffered(br) >= br.cap) { return BR_TOO_LONG; }

        let is i64 as f = br_fill(br);
        if (f < 0) { return f; }
        if (f == 0) {
            // EOF: hand back whatever is left as the final, unterminated line.
            let is i64 as rest = br_buffered(br);
            if (rest == 0) { return BR_EOF; }
            let is i64 as n with mut = rest;
            if (n > 0 && br.buf[br.head + n - 1] == 13) { n = n - 1; }
            if (n + 1 > max) { return BR_TOO_LONG; }
            if (n > 0) { mem.core.memcpy(out, cast(*u8, cast(i64, br.buf) + br.head), n); }
            out[n] = cast(u8, 0);
            br.head = 0;
            br.tail = 0;
            return n;
        }
    }
    return BR_EOF;
}

// =======================================================
// Heap-allocated form, for callers that do not want to own the storage.
// Shares the Conn heap so a connection's reader and its Conn die together.
// =======================================================

// Allocate a BufReader plus its buffer. `cap` <= 0 means DEFAULT_CAP.
// Returns null on allocation failure.
fn br_new(c as *conn.Conn, cap as i64) as *BufReader {
    let is i64 as n with mut = cap;
    if (n <= 0) { n = DEFAULT_CAP; }
    let is *BufReader as br = cast(*BufReader, conn.cn_alloc(sizeof(BufReader)));
    if (cast(i64, br) == 0) { return cast(*BufReader, 0); }
    let is *u8 as buf = conn.cn_alloc(n);
    if (cast(i64, buf) == 0) { conn.cn_free(cast(*u8, br)); return cast(*BufReader, 0); }
    br_init(br, c, buf, n);
    return br;
}

// Free a reader made by br_new. Does NOT touch the underlying Conn.
fn br_free(br as *BufReader) as void {
    if (cast(i64, br) == 0) { return; }
    if (cast(i64, br.buf) != 0) { conn.cn_free(br.buf); }
    conn.cn_free(cast(*u8, br));
}
