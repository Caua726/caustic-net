// =======================================================
// caustic-net/core/bytes.cst
// Bytes  — growable, owned heap buffer (parsers/builders accumulate here).
// Slice  — borrowed view (ptr+len), no ownership (zero-copy header values).
// The hot path (conn_read/write) uses raw *u8+len and never touches Bytes.
//
// Two allocators, chosen by size. The stdlib `bins` allocator refuses any
// single request above its largest bin, so on its own it cannot back an HTTP
// body — past SMALL_MAX a buffer is page-allocated instead. `cap` is always
// the exact size handed to the allocator, so a free knows which one owns the
// pointer and how much to give back.
// =======================================================

use "std/mem.cst" only bins, core as mem;

struct Bytes {
    ptr as *u8;
    len as i64;
    cap as i64;
}

struct Slice {
    ptr as *u8;
    len as i64;
}

// Largest capacity served from `bins`; anything above comes from pages. Set
// well inside the bins ceiling, which rejects a request at its own top bin.
let is i64 as SMALL_MAX with imut = 16384;
let is i64 as PAGE      with imut = 4096;

let is mem.Bins as _bins with mut;
let is i32 as _ready with mut = 0;

// Page-round a capacity destined for the page allocator, so the size passed to
// alloc is exactly the size passed back to free.
fn _round_pages(n as i64) as i64 {
    return ((n + PAGE - 1) / PAGE) * PAGE;
}

// Allocate exactly `size` bytes, or null. mmap signals failure with
// MAP_FAILED — (void*)-1, not null — so both sentinels are folded to null.
fn _b_alloc(size as i64) as *u8 {
    if (size > SMALL_MAX) {
        let is *u8 as p = mem.core.mmap_anon(size);
        if (cast(i64, p) == 0 || cast(i64, p) == 0 - 1) { return cast(*u8, 0); }
        return p;
    }
    if (_ready == 0) { _bins = mem.bins.bins_new(65536); _ready = 1; }
    return mem.bins.bins_alloc(&_bins, size);
}

// Release a block of exactly `size` bytes — the size it was allocated with.
fn _b_free(ptr as *u8, size as i64) as void {
    if (cast(i64, ptr) == 0) { return; }
    if (size > SMALL_MAX) { mem.core.munmap(ptr, size); return; }
    if (_ready == 1) { mem.bins.bins_free(&_bins, ptr); }
}

// New buffer with capacity `cap` (>=1). len starts at 0.
// On allocation failure the result is inert — ptr null AND cap 0 — so a later
// append takes the grow path and fails cleanly instead of writing through null.
fn bytes_new(cap as i64) as Bytes {
    let is i64 as c with mut = cap;
    if (c < 1) { c = 16; }
    if (c > SMALL_MAX) { c = _round_pages(c); }
    let is Bytes as b;
    b.ptr = _b_alloc(c);
    b.len = 0;
    b.cap = c;
    if (cast(i64, b.ptr) == 0) { b.cap = 0; }
    return b;
}

// Ensure room for at least `extra` more bytes; grows (doubling) if needed.
// Returns 0 ok, <0 if the buffer could not grow.
fn bytes_reserve(b as *Bytes, extra as i64) as i64 {
    if (extra <= 0) { return 0; }
    let is i64 as need = b.len + extra;
    if (need < 0) { return 0 - 1; }                                  // i64 overflow
    if (need <= b.cap && cast(i64, b.ptr) != 0) { return 0; }

    // Doubling from a floor of 16: a zero cap (a Bytes that was zeroed rather
    // than built by bytes_new, or one whose allocation failed) must not spin
    // here — 0 * 2 never reaches `need`.
    let is i64 as ncap with mut = b.cap;
    if (ncap < 16) { ncap = 16; }
    while (ncap < need) { ncap = ncap * 2; }
    if (ncap > SMALL_MAX) { ncap = _round_pages(ncap); }

    let is *u8 as np = _b_alloc(ncap);
    if (cast(i64, np) == 0) { return 0 - 1; }
    if (b.len > 0) { mem.core.memcpy(np, b.ptr, b.len); }
    _b_free(b.ptr, b.cap);
    b.ptr = np;
    b.cap = ncap;
    return 0;
}

// Append `n` bytes from `src`. Returns 0 ok, <0 on alloc failure.
fn bytes_append(b as *Bytes, src as *u8, n as i64) as i64 {
    if (n <= 0) { return 0; }
    if (bytes_reserve(b, n) < 0) { return 0 - 1; }
    mem.core.memcpy(cast(*u8, cast(i64, b.ptr) + b.len), src, n);
    b.len = b.len + n;
    return 0;
}

// Append a NUL-terminated string, without its terminator. Builders — request
// lines, header names — accumulate through this. Returns 0 ok, <0 on failure.
fn bytes_append_str(b as *Bytes, s as *u8) as i64 {
    if (cast(i64, s) == 0) { return 0; }
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return bytes_append(b, s, n);
}

// Append a single byte.
fn bytes_push(b as *Bytes, byte as u8) as i64 {
    if (bytes_reserve(b, 1) < 0) { return 0 - 1; }
    b.ptr[b.len] = byte;
    b.len = b.len + 1;
    return 0;
}

// A borrowed view of [off, off+n) inside b, clamped to the filled region. An
// out-of-range request yields an empty Slice rather than a wild pointer.
fn bytes_slice(b as *Bytes, off as i64, n as i64) as Slice {
    let is Slice as s;
    s.ptr = cast(*u8, 0);
    s.len = 0;
    if (off < 0 || n < 0 || off > b.len) { return s; }
    let is i64 as k with mut = n;
    if (off + k > b.len) { k = b.len - off; }
    s.ptr = cast(*u8, cast(i64, b.ptr) + off);
    s.len = k;
    return s;
}

fn bytes_reset(b as *Bytes) as void {
    b.len = 0;
}

fn bytes_free(b as *Bytes) as void {
    _b_free(b.ptr, b.cap);
    b.ptr = cast(*u8, 0);
    b.len = 0;
    b.cap = 0;
}
