// =======================================================
// caustic-net/core/conn.cst
// The Conn abstraction — a generic byte stream behind a
// function-pointer vtable. Plain TCP and TLS both implement
// the SAME Conn, so HTTP/WS/fetch never know which is underneath.
//
// The vtable is a struct of fn_ptr-as-*u8 fields + an opaque
// ctx. call() on a stored *u8 pointer is an untyped indirect
// call (verified pattern: std/sort.cst stores `cmp as *u8` and
// does `call(cmp, ...)`), so every call() lives in exactly the
// four typed dispatchers below — nowhere else.
// =======================================================

use "std/mem.cst" only bins, core as mem;
use "std/time.cst" as time;
use "./errno.cst" as errno;

// --- Connection state codes (returned by the `state` vtable slot) ---
let is i64 as CONN_OPEN   with imut = 0;   // usable
let is i64 as CONN_EOF    with imut = 1;   // peer closed cleanly (read returned 0)
let is i64 as CONN_CLOSED with imut = 2;   // we closed it
let is i64 as CONN_ERROR  with imut = 3;   // an I/O error occurred

// Vtable contract (each backend takes the opaque ctx first):
//   read : fn(ctx as *u8, buf as *u8, len as i64) as i64   // >0 n, 0 EOF, <0 -errno
//   write: fn(ctx as *u8, buf as *u8, len as i64) as i64   // >0 n, <0 -errno
//   close: fn(ctx as *u8) as i64                           // 0 ok, <0 -errno
//   state: fn(ctx as *u8) as i64                           // CONN_* code
struct Conn {
    ctx   as *u8;   // opaque backend context (*TcpCtx, *TlsConn, mock, ...)
    read  as *u8;   // fn_ptr(backend read)
    write as *u8;   // fn_ptr(backend write)
    close as *u8;   // fn_ptr(backend close)
    state as *u8;   // fn_ptr(backend state)
}

// --- The only four call() sites. Typed surface for everyone else. ---

fn conn_read(c as *Conn, buf as *u8, len as i64) as i64 {
    return call(c.read, c.ctx, buf, len);
}

fn conn_write(c as *Conn, buf as *u8, len as i64) as i64 {
    return call(c.write, c.ctx, buf, len);
}

fn conn_close(c as *Conn) as i64 {
    return call(c.close, c.ctx);
}

fn conn_state(c as *Conn) as i64 {
    return call(c.state, c.ctx);
}

// --- Loop helpers (mirror net.send_all / net.recv_all over the vtable) ---

// A signal delivered mid-syscall surfaces as -EINTR and means nothing was
// transferred, so the loops below retry rather than abort a whole message.
// std/net does not retry, so this is the only place it happens.
let is i64 as _EINTR with imut = 4;

// --- Deadlines ---
//
// An absolute monotonic millisecond stamp; 0 means "no deadline". A deadline
// bounds a whole multi-read operation, which a per-socket timeout cannot: a
// peer that dribbles one byte per SO_RCVTIMEO window keeps a plain
// conn_read_exact alive forever, and that is exactly the slow-loris shape.
//
// It is checked BETWEEN reads, so it can only fire if the individual reads
// return. Pair it with tp.set_recv_timeout(conn, secs) on a blocking socket:
// the socket timeout makes each read return -EAGAIN, and the deadline decides
// whether to try again or give up.

fn deadline_in(ms as i64) as i64 {
    return time.now_ms() + ms;
}

fn deadline_expired(d as i64) as i64 {
    if (d <= 0) { return 0; }
    if (time.now_ms() >= d) { return 1; }
    return 0;
}

// Milliseconds left, or -1 when there is no deadline. Never negative.
fn deadline_remaining(d as i64) as i64 {
    if (d <= 0) { return 0 - 1; }
    let is i64 as left = d - time.now_ms();
    if (left < 0) { return 0; }
    return left;
}

// Write every byte. Returns total sent, or <0 on error, or partial on EOF.
fn conn_write_all(c as *Conn, buf as *u8, len as i64) as i64 {
    let is i64 as sent with mut = 0;
    while (sent < len) {
        let is i64 as n = conn_write(c, cast(*u8, cast(i64, buf) + sent), len - sent);
        if (n == 0 - _EINTR) { continue; }
        if (n < 0) { return n; }
        if (n == 0) {
            if (sent > 0) { return sent; }
            return 0 - 1;
        }
        sent = sent + n;
    }
    return sent;
}

// Read exactly len bytes. Returns len, or got<len on EOF, or <0 on error.
fn conn_read_exact(c as *Conn, buf as *u8, len as i64) as i64 {
    let is i64 as got with mut = 0;
    while (got < len) {
        let is i64 as n = conn_read(c, cast(*u8, cast(i64, buf) + got), len - got);
        if (n == 0 - _EINTR) { continue; }
        if (n < 0) { return n; }
        if (n == 0) { return got; }
        got = got + n;
    }
    return got;
}

// --- Deadline-bounded forms ---
//
// `deadline` is an absolute stamp from deadline_in(), or 0 for none (in which
// case these behave exactly like the plain forms above). Returns -ETIMEDOUT
// once the deadline passes with the transfer incomplete.
//
// -EAGAIN is retried only when there IS a deadline, because that is the
// socket-timeout case and the deadline is what eventually stops it. With no
// deadline it is handed back, so a non-blocking caller still drives readiness
// itself instead of spinning here.

fn conn_read_exact_by(c as *Conn, buf as *u8, len as i64, deadline as i64) as i64 {
    let is i64 as got with mut = 0;
    while (got < len) {
        if (deadline_expired(deadline) == 1) { return 0 - errno.ETIMEDOUT; }
        let is i64 as n = conn_read(c, cast(*u8, cast(i64, buf) + got), len - got);
        if (n == 0 - _EINTR) { continue; }
        if (n == 0 - errno.EAGAIN && deadline > 0) { continue; }
        if (n < 0) { return n; }
        if (n == 0) { return got; }
        got = got + n;
    }
    return got;
}

fn conn_write_all_by(c as *Conn, buf as *u8, len as i64, deadline as i64) as i64 {
    let is i64 as sent with mut = 0;
    while (sent < len) {
        if (deadline_expired(deadline) == 1) { return 0 - errno.ETIMEDOUT; }
        let is i64 as n = conn_write(c, cast(*u8, cast(i64, buf) + sent), len - sent);
        if (n == 0 - _EINTR) { continue; }
        if (n == 0 - errno.EAGAIN && deadline > 0) { continue; }
        if (n < 0) { return n; }
        if (n == 0) {
            if (sent > 0) { return sent; }
            return 0 - 1;
        }
        sent = sent + n;
    }
    return sent;
}

// =======================================================
// Shared allocator for Conn boxes and their backend contexts.
// Every Conn-producer (tcp_conn, tls, ...) allocates through
// cn_alloc so conn_free can release ctx + box with one heap.
// =======================================================
// Zero-initialised in BSS, and initialised on first use by bins itself.
//
// This used to carry a `_ready` flag and call bins_new on the first alloc.
// That check-then-set is not atomic, and the moment two threads each opened a
// connection at the same time — a server accepting while a client dialled —
// both saw _ready at 0 and both built a heap over the same struct. The result
// was a hang, not a crash, which is the worst way for it to present.
//
// bins_alloc already lazy-initialises a zeroed Bins UNDER ITS OWN LOCK, so
// the correct amount of code here is none. std/thread's spawn calls
// memcore.set_mt(), which is what turns that lock on.
let is mem.Bins as _bins with mut;

fn cn_alloc(size as i64) as *u8 {
    return mem.bins.bins_alloc(&_bins, size);
}

// Force the shared heap into existence, before any thread can exist.
//
// bins_alloc lazy-initialises a zeroed Bins under its own lock, and that is
// safe against concurrent ALLOCATION. It is not safe against two threads
// arriving at the UNINITIALISED state together: a server thread accepting
// while the main thread dials deadlocks, both inside bins_alloc, with no
// error and no crash — the process simply stops. It was reproduced on the
// first threaded test in this repository and it is a property of the standard
// library, not of this file.
//
// So the heap is built once while the program is still single-threaded.
// transport.init() calls this, which is why every example starts with it; a
// program that spawns threads without going through transport has to call it
// itself. Idempotent and cheap.
fn conn_heap_warm() as void {
    let is *u8 as p = cn_alloc(64);
    if (cast(i64, p) != 0) { cn_free(p); }
}

fn cn_free(ptr as *u8) as void {
    if (cast(i64, ptr) == 0) { return; }
    mem.bins.bins_free(&_bins, ptr);
}

// Allocate a zeroed Conn box.
fn conn_new() as *Conn {
    let is *Conn as c = cast(*Conn, cn_alloc(sizeof(Conn)));
    mem.core.memset(cast(*u8, c), cast(i32, 0), sizeof(Conn));
    return c;
}

// Close (idempotent at the backend) and free the box + its ctx.
fn conn_free(c as *Conn) as void {
    if (cast(i64, c) == 0) { return; }
    conn_close(c);
    if (cast(i64, c.ctx) != 0) { cn_free(c.ctx); }
    cn_free(cast(*u8, c));
}
