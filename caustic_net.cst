// =======================================================
// caustic-net — pure-Caustic networking library (facade)
//
// Re-exports the public modules so a consumer can:
//   use "caustic-net/caustic_net.cst" as cnet;
//   cnet.conn.conn_read(...);  cnet.transport.dial(...);
//
// Compile-check the whole library with:  caustic -c caustic_net.cst
// Modules land phase by phase (see ROADMAP / plan); this list grows.
//
// Every path here is explicitly "./"-relative. A bare `use "core/conn.cst"`
// resolves to this directory today only because source-relative is tried
// before the --path list — and caustic-compact ships a `core/` of its own, as
// does any library of size. Leaning on resolution order for that is one
// declaration away from importing someone else's `core/bytes.cst` in silence.
// tests/run.cst enforces the rule for the whole library.
// =======================================================

use "./core/conn.cst" as conn;
use "./core/errno.cst" as errno;
use "./core/entropy.cst" as entropy;
use "./core/chrono.cst" as chrono;
use "./core/bytes.cst" as bytes;
use "./core/bufread.cst" as bufread;
use "./transport/tcp_conn.cst" as tcp;
use "./transport/resolver.cst" as resolver;
use "./transport/transport.cst" as transport;
use "./proto/dns.cst" as dns;
use "./proto/url.cst" as url;
use "./proto/http1.cst" as http1;
use "./tls/transcript.cst" as transcript;
use "./tls/keysched.cst" as keysched;
use "./tls/record.cst" as record;
use "./tls/x509.cst" as x509;
use "./tls/pss.cst" as pss;
use "./tls/roots.cst" as roots;
use "./tls/trust.cst" as trust;
use "./tls/verify.cst" as verify;
